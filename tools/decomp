#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

case "${1:-}" in
    options)
        shift
        exec "$ROOT/.tooling/venv/bin/python" -m tools.decomp_options "$@"
        ;;
    study)
        shift
        exec "$ROOT/.tooling/venv/bin/python" -m tools.decomp_study "$@"
        ;;
esac

if [[ -f .decomp-local ]]; then
    source .decomp-local
fi

build_jobs="${TOY2_BUILD_JOBS:-${TOY2_LOCAL_BUILD_JOBS:-4}}"

configure() {
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_SYSTEM_NAME=Windows \
        -DCMAKE_C_COMPILER=cl \
        -DCMAKE_CXX_COMPILER=cl \
        -DCMAKE_RC_COMPILER=rc \
        -DCMAKE_C_DEPFILE_FORMAT=msvc \
        -DCMAKE_DEPFILE_FLAGS_C=/showIncludes \
        -DCMAKE_CXX_DEPFILE_FORMAT=msvc \
        -DCMAKE_DEPFILE_FLAGS_CXX=/showIncludes
}

build() {
    if [[ ! -f build/build.ninja ]]; then
        configure || return
    fi
    cmake --build build -- "-j${build_jobs}" || return
    (
        cd build
        reccmp-project detect --what recompiled
    ) || return
}

build_game() {
    if [[ ! -f build/build.ninja ]]; then
        configure || return
    fi
    cmake --build build --target toy2decomp -- "-j${build_jobs}" || return
    (
        cd build
        reccmp-project detect --what recompiled
    ) || return
}

# Print only the per-function similarity verdict for each given address. One
# PDB parse serves every address, and no assembly diff reaches the caller.
score() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: tools/decomp score <address> [address...]" >&2
        return 2
    fi
    for argument in "$@"; do
        if [[ $argument == -h || $argument == --help ]]; then
            python tools/decomp_verify.py score --help
            return
        fi
    done
    ensure_build
    write_comparison_report decomp-score-report.json
    python tools/decomp_verify.py score build/decomp-score-report.json "$@"
    for address in "$@"; do
        if [[ $address =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
            python tools/decomp_campaigns.py first-score \
                --address "$address" \
                --report build/decomp-score-report.json \
                --score-functions-map tools/Resources/functions_map.txt \
                --score-function-sizes build/decomp-function-sizes.json \
                --score-source-root src \
                --quiet
        fi
    done
}

ensure_build() {
    build_game
}

write_comparison_report() {
    local output_name="$1"
    local report_path="$output_name"
    local input_receipt="build/decomp-cache/provenance/report-input-${BASHPID}.json"
    if [[ $report_path != /* ]]; then
        report_path="build/$report_path"
    fi
    if ! python tools/decomp_provenance.py capture-input "$input_receipt" \
        --output "$report_path" >/dev/null; then
        return 1
    fi
    if ! (
        cd build
        reccmp-reccmp --target TOY2 --silent --no-color --json "$output_name"
    ) >/dev/null; then
        rm -f "$input_receipt"
        return 1
    fi
    if ! python tools/decomp_provenance.py seal-report "$report_path" \
        --input-receipt "$input_receipt" >/dev/null; then
        rm -f "$input_receipt"
        return 1
    fi
    rm -f "$input_receipt"
}

write_data_report() {
    local output_name="$1"
    local report_path="$output_name"
    local input_receipt="build/decomp-cache/provenance/data-input-${BASHPID}.json"
    if [[ $report_path != /* ]]; then
        report_path="build/$report_path"
    fi
    if ! python tools/decomp_provenance.py capture-input "$input_receipt" \
        --output "$report_path" >/dev/null; then
        return 1
    fi
    if ! python tools/generate-decomp-data-report.py \
        --original original/toy2.exe \
        --recompiled build/toy2.exe \
        --pdb build/toy2.pdb \
        --source-root src \
        --output "$report_path"; then
        rm -f "$input_receipt"
        return 1
    fi
    if ! python tools/decomp_provenance.py seal-report "$report_path" \
        --input-receipt "$input_receipt" >/dev/null; then
        rm -f "$input_receipt"
        return 1
    fi
    rm -f "$input_receipt"
}

function_sizes_are_valid() {
    python -c \
        'import sys; from pathlib import Path; from tools.ghidra_sync import _read_snapshot_sizes; _read_snapshot_sizes(Path(sys.argv[1]))' \
        "$1" >/dev/null 2>&1
}

ensure_candidate_report() {
    if python tools/decomp_provenance.py validate-report \
        build/decomp-current-report.json >/dev/null 2>&1; then
        return 0
    fi
    ensure_build || return
    refresh_function_sizes || return
    write_comparison_report decomp-current-report.json
}

refresh_function_sizes() {
    local function_sizes="build/decomp-function-sizes.json"
    local temporary_sizes="build/decomp-function-sizes.json.tmp"
    if command -v ghidra >/dev/null 2>&1; then
        if ghidra function list --json --limit 0 --fields address,size > "$temporary_sizes" && \
            function_sizes_are_valid "$temporary_sizes"; then
            mv "$temporary_sizes" "$function_sizes" || return
        else
            rm -f "$temporary_sizes"
            echo "warning: kept the existing function-size snapshot" >&2
        fi
    else
        echo "warning: Ghidra is unavailable; kept the existing function-size snapshot" >&2
    fi
    if ! function_sizes_are_valid "$function_sizes"; then
        echo "error: no valid retail function-size snapshot is available" >&2
        return 1
    fi
}

baseline() {
    if [[ $# -gt 0 ]]; then
        for argument in "$@"; do
            if [[ $argument == -h || $argument == --help ]]; then
                echo "Usage: tools/decomp baseline"
                return
            fi
        done
        echo "error: baseline does not accept arguments" >&2
        return 2
    fi
    build || return
    write_comparison_report decomp-baseline-report.json || return
    write_data_report decomp-baseline-data-report.json || return
    python tools/decomp_verify.py metadata build/decomp-baseline-meta.json \
        --report build/decomp-baseline-report.json \
        --data-report build/decomp-baseline-data-report.json || return
    local revision
    revision=$(git rev-parse --short HEAD) || return
    echo "Wrote build/decomp-baseline-report.json for $revision."
}

validate() {
    local accounting_correction=""
    local allow_target_regression=0
    local meta_resolution=0
    local mode=""
    local resource=""
    local staged=0
    local targets=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 ]] || { echo "error: --target needs an address" >&2; return 2; }
                targets+=("$2")
                shift 2
                ;;
            --allow-target-regression)
                allow_target_regression=1
                shift
                ;;
            --mode)
                [[ $# -ge 2 ]] || {
                    echo "error: --mode needs a campaign type" >&2
                    return 2
                }
                mode="$2"
                shift 2
                ;;
            --resource)
                [[ $# -ge 2 ]] || {
                    echo "error: --resource needs TYPE,ID,LANGUAGE" >&2
                    return 2
                }
                resource="$2"
                shift 2
                ;;
            --accounting-correction)
                [[ $# -ge 2 ]] || {
                    echo "error: --accounting-correction needs a reason" >&2
                    return 2
                }
                accounting_correction="$2"
                shift 2
                ;;
            --meta-resolution)
                meta_resolution=1
                shift
                ;;
            --staged)
                staged=1
                shift
                ;;
            *)
                echo "error: unknown validate argument: $1" >&2
                return 2
                ;;
        esac
    done
    if [[ $mode != resource && ${#targets[@]} -eq 0 ]]; then
        echo "error: validate needs at least one --target address" >&2
        return 2
    fi
    if [[ -n $mode && $mode != coverage && $mode != refinement && $mode != data && $mode != resource ]]; then
        echo "error: unknown validation mode: $mode" >&2
        return 2
    fi
    if [[ $mode == resource && ${#targets[@]} -gt 0 ]]; then
        echo "error: a resource campaign cannot have target addresses" >&2
        return 2
    fi
    if [[ $mode == resource && -z $resource ]]; then
        echo "error: a resource campaign needs exactly one --resource" >&2
        return 2
    fi
    if [[ $mode != resource && -n $resource ]]; then
        echo "error: --resource requires --mode resource" >&2
        return 2
    fi
    if [[ $meta_resolution -eq 0 && -z $mode ]]; then
        echo "error: validate needs --mode coverage, refinement, or data" >&2
        return 2
    fi
    if [[ $mode == data && ${#targets[@]} -gt 3 ]]; then
        echo "error: a data campaign can have at most three targets" >&2
        return 2
    fi
    if [[ $allow_target_regression -eq 1 && $meta_resolution -eq 0 ]]; then
        echo "error: --allow-target-regression requires --meta-resolution" >&2
        return 2
    fi
    if [[ -n $accounting_correction && $meta_resolution -eq 0 ]]; then
        echo "error: --accounting-correction requires --meta-resolution" >&2
        return 2
    fi
    if [[ -n $accounting_correction && $mode != data ]]; then
        echo "error: --accounting-correction requires --mode data" >&2
        return 2
    fi
    if [[ ! -f build/decomp-baseline-report.json ]]; then
        echo "error: run tools/decomp baseline before you edit source" >&2
        return 2
    fi
    if [[ ( $mode == data || $mode == resource ) && ! -f build/decomp-baseline-data-report.json ]]; then
        echo "error: run tools/decomp baseline before a data campaign" >&2
        return 2
    fi
    if [[ $mode == data && $staged -eq 1 && -z $accounting_correction ]] && \
        git diff --cached --quiet -- src; then
        echo "error: a staged data campaign must change the source tree" >&2
        return 2
    fi

    build
    write_comparison_report decomp-current-report.json
    if [[ $mode == data || $mode == resource ]]; then
        write_data_report decomp-current-data-report.json
    fi
    local verify_args=(
        validate
        build/decomp-baseline-report.json
        build/decomp-current-report.json
        "${targets[@]}"
        --metadata build/decomp-baseline-meta.json
    )
    if [[ $allow_target_regression -eq 1 ]]; then
        verify_args+=(--allow-target-regression)
    fi
    if [[ $meta_resolution -eq 1 ]]; then
        verify_args+=(--meta-resolution)
    fi
    if [[ $staged -eq 1 ]]; then
        verify_args+=(--staged)
    fi
    if [[ -n $mode ]]; then
        verify_args+=(--mode "$mode")
    fi
    if [[ -n $resource ]]; then
        verify_args+=(--resource "$resource")
    fi
    if [[ $mode == data || $mode == resource ]]; then
        verify_args+=(
            --baseline-data build/decomp-baseline-data-report.json
            --current-data build/decomp-current-data-report.json
        )
    fi
    if [[ -n $accounting_correction ]]; then
        verify_args+=(--accounting-correction "$accounting_correction")
    fi
    python tools/decomp_verify.py "${verify_args[@]}"
    for target in "${targets[@]}"; do
        score_artifact=(--report build/decomp-current-report.json)
        if [[ $mode == data ]]; then
            score_artifact=(--data-report build/decomp-current-data-report.json)
        fi
        python tools/decomp_campaigns.py first-score \
            --address "$target" \
            "${score_artifact[@]}" \
            --score-functions-map tools/Resources/functions_map.txt \
            --score-function-sizes build/decomp-function-sizes.json \
            --score-source-root src \
            --quiet
    done
    if [[ $mode == resource ]]; then
        python tools/decomp_campaigns.py resource-score --quiet
    fi
    if [[ $staged -eq 1 ]]; then
        python tools/decomp_lint.py --staged --warnings-as-errors
    fi
    python tools/ghidra_sync.py check
    git diff --check
}

experiment() {
    local action="${1:-}"
    shift || true
    if [[ -z "$action" ]]; then
        echo "Usage: tools/decomp experiment start|branch|measure|try|seal|status|best|advise|report <address> [label] [options]" >&2
        return 2
    fi
    case "$action" in
        start)
            local address="${1:-}"
            [[ -n "$address" ]] || {
                echo "error: experiment start needs an address" >&2
                return 2
            }
            shift
            local plan_text
            plan_text=$(python tools/decomp_experiment.py begin-session \
                "$address" "$@" --format lines) || return
            local plan=()
            mapfile -t plan <<< "$plan_text"
            [[ ${#plan[@]} -eq 7 ]] || {
                echo "error: the experiment session plan is incomplete" >&2
                return 2
            }
            local session_id="${plan[0]}"
            local session_directory="${plan[1]}"
            local baseline_report="${plan[2]}"
            local baseline_data_report="${plan[3]}"
            local compiler_context="${plan[4]}"
            local source_patch="${plan[5]}"
            local build_lock="${plan[6]}"
            (
                flock 9
                build || return
                refresh_function_sizes || return
                write_comparison_report "$baseline_report" || return
                write_data_report "$baseline_data_report" || return
                python tools/decomp_verify.py metadata "$compiler_context" \
                    --report "$baseline_report" \
                    --data-report "$baseline_data_report" || return
                git diff --binary > "$source_patch" || return
                python tools/decomp_experiment.py attach-baseline "$address" \
                    --session "$session_id" >/dev/null || return
            ) 9>"$build_lock" || return
            echo "Started experiment $address in $session_directory."
            ;;
        branch)
            local address="${1:-}"
            local label="${2:-}"
            if [[ -z "$address" || -z "$label" ]]; then
                echo "error: experiment branch needs an address and a label" >&2
                return 2
            fi
            shift 2
            python tools/decomp_experiment.py branch "$address" "$label" "$@"
            ;;
        try|measure)
            local address="${1:-}"
            local label="${2:-}"
            if [[ -z "$address" || -z "$label" ]]; then
                echo "error: experiment $action needs an address and a label or trial ID" >&2
                return 2
            fi
            shift 2
            local trial_plan_text
            if [[ $action == try ]]; then
                trial_plan_text=$(python tools/decomp_experiment.py reserve \
                    "$address" "$label" "$@" --format lines) || return
            else
                trial_plan_text=$(python tools/decomp_experiment.py measure-plan \
                    "$address" --trial "$label" "$@" --format lines) || return
            fi
            local trial_plan=()
            mapfile -t trial_plan <<< "$trial_plan_text"
            [[ ${#trial_plan[@]} -eq 8 ]] || {
                echo "error: the experiment trial plan is incomplete" >&2
                return 2
            }
            local session_id="${trial_plan[0]}"
            local trial_id="${trial_plan[1]}"
            local trial_directory="${trial_plan[2]}"
            local trial_report="${trial_plan[3]}"
            local trial_diff="${trial_plan[4]}"
            local source_patch="${trial_plan[5]}"
            local compiler_context="${trial_plan[6]}"
            local build_lock="${trial_plan[7]}"
            (
                trap 'python tools/decomp_experiment.py fail "$address" --session "$session_id" --trial "$trial_id" --stage interrupted --message "The experiment wrapper was interrupted." >/dev/null 2>&1 || true; exit 130' INT TERM HUP
                flock 9
                local failure_code
                if build_game; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage build --exit-code "$failure_code" \
                        --message "The experiment build failed." >/dev/null || true
                    return "$failure_code"
                fi
                if write_comparison_report "$trial_report"; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage comparison --exit-code "$failure_code" \
                        --message "The experiment comparison failed." >/dev/null || true
                    return "$failure_code"
                fi
                if git diff --binary > "$source_patch"; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage normalize --exit-code "$failure_code" \
                        --message "The experiment source patch failed." >/dev/null || true
                    return "$failure_code"
                fi
                if (cd build && reccmp-reccmp --target TOY2 --no-color --verbose "$address") \
                    > "$trial_diff"; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage diff --exit-code "$failure_code" \
                        --message "The verbose experiment comparison failed." >/dev/null || true
                    return "$failure_code"
                fi
                if python tools/decomp_provenance.py seal-diff "$trial_diff" \
                    --address "$address" --report "$trial_report" >/dev/null; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage diff --exit-code "$failure_code" \
                        --message "The verbose experiment provenance failed." >/dev/null || true
                    return "$failure_code"
                fi
                if python tools/decomp_verify.py metadata "$compiler_context" \
                    --report "$trial_report"; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage normalize --exit-code "$failure_code" \
                        --message "The experiment compiler context failed." >/dev/null || true
                    return "$failure_code"
                fi
                if python tools/decomp_experiment.py record "$address" \
                    --session "$session_id" --trial "$trial_id"; then
                    :
                else
                    failure_code=$?
                    python tools/decomp_experiment.py fail "$address" --session "$session_id" \
                        --trial "$trial_id" --stage normalize --exit-code "$failure_code" \
                        --message "The experiment record failed." >/dev/null || true
                    return "$failure_code"
                fi
                trap - INT TERM HUP
                python tools/decomp_campaigns.py first-score \
                    --address "$address" \
                    --report "$trial_report" \
                    --score-functions-map tools/Resources/functions_map.txt \
                    --score-function-sizes build/decomp-function-sizes.json \
                    --score-source-root src \
                    --quiet
            ) 9>"$build_lock"
            ;;
        status|best|advise|report|seal)
            python tools/decomp_experiment.py "$action" "$@"
            ;;
        *)
            echo "error: experiment action must be start, branch, measure, try, seal, status, best, advise, or report" >&2
            return 2
            ;;
    esac
}

report() {
    local output="${1:-build/decomp-report.html}"
    local report_json="build/decomp-current-report.json"
    local report_summary="build/decomp-report-summary.txt"
    local function_sizes="build/decomp-function-sizes.json"
    local data_report="build/decomp-current-data-report.json"

    if [[ $# -gt 1 ]]; then
        echo "Usage: tools/decomp report [output.html]" >&2
        return 2
    fi
    ensure_build
    refresh_function_sizes
    local report_input="build/decomp-cache/provenance/report-input-${BASHPID}.json"
    python tools/decomp_provenance.py capture-input "$report_input" \
        --output "$report_json" >/dev/null

    (
        cd build
        reccmp-reccmp \
            --target TOY2 \
            --silent \
            --no-color \
            --json "$(basename "$report_json")"
    ) > "$report_summary"
    cat "$report_summary"
    python tools/decomp_provenance.py seal-report "$report_json" \
        --input-receipt "$report_input" >/dev/null
    rm -f "$report_input"

    local data_input="build/decomp-cache/provenance/data-input-${BASHPID}.json"
    python tools/decomp_provenance.py capture-input "$data_input" \
        --output "$data_report" >/dev/null
    python tools/generate-decomp-data-report.py \
        --original original/toy2.exe \
        --recompiled build/toy2.exe \
        --pdb build/toy2.pdb \
        --source-root src \
        --output "$data_report"
    python tools/decomp_provenance.py seal-report "$data_report" \
        --input-receipt "$data_input" >/dev/null
    rm -f "$data_input"

    python tools/generate-decomp-report.py \
        --input "$report_json" \
        --summary "$report_summary" \
        --source-root src \
        --functions-map tools/Resources/functions_map.txt \
        --function-sizes "$function_sizes" \
        --retail-exe original/toy2.exe \
        --recompiled-exe build/toy2.exe \
        --data-report "$data_report" \
        --template tools/decomp-report-template.html \
        --output "$output"
}

usage() {
    cat <<'EOF'
Usage: tools/decomp <command> [arguments]

Commands:
  configure         Configure the VC6 SP3 build through Wine
  build             Build toy2.exe/patcher.dll and register the output
  compare [args]    Run reccmp against the reference and recompiled EXEs
  score <addr>...   Print only the similarity verdict for one or more addresses
  bc <addr>         Build toy2.exe, then compare one address verbosely
  notes <query>     Search bounded codegen, source-model, debt, and name notes
  candidates [ns]   Refresh stale comparison evidence, then rank candidates
  doctor [args]     Check source-work tools before a campaign starts
  brief [args]      Build or read an immutable target evidence brief
  context --brief   Validate and display one brief's function context pack
  impact [...]      Create or verify an independent impact review
  oracle [...]      Run or verify a finite allowlisted leaf check
  campaigns [...]   Measure campaign time, report deltas, and retained throughput
  discover [args]   Find credible Ghidra starts absent from the function map
  defer <addr> ...  Record a committed blocker or prerequisite
  undefer <addr>    Clear all committed blockers for one target
  blockers [addr]   Show committed blockers
  evidence <addr>   Collect bounded evidence for one target in a single call
  baseline          Save a fresh parent-state comparison before source edits
  validate [args]   Enforce coverage, refinement, data, or resource success
  finalize [args]   Validate once and write a content-addressed receipt
  experiment [...] Record labeled source-form comparison trials
  replay [...]     Enroll and certify the private replay benchmark
  route advise     Give route advice only after replay certification
  options [...]    Show the default-off option and training registry
  study [...]      Store and evaluate private unverified study corpora
  lint [files]      Check reconstructed source for decompiler residue
  names             Re-extract .notes/original-names.md from the retail binary
  data [addr]       Show type-aware initialized-global differences
  report [file]     Generate the self-contained HTML decompilation dashboard
  session-summary   Summarize selected targets against the saved baseline
  progress [--json] [scope]  Show annotation progress
  check             Verify functions_map.txt is sorted, deduplicated, named, in-range
  run [args]        Run the recompiled toy2.exe through Wine
  shell             Start a shell with the decompilation environment active
  sync [args]       Import matched functions/types/globals into Ghidra via reccmp

`candidates` reads the retail binary, committed files, and build reports. The
wrapper refreshes stale Ghidra size and reccmp evidence first. `evidence` makes
bounded Ghidra queries:
  tools/decomp candidates --why
  tools/decomp candidates --coverage --why
  tools/decomp candidates --refine --why
  tools/decomp candidates --refine --yield --why
  tools/decomp campaigns summary
  tools/decomp candidates --diagnose
  tools/decomp candidates --for 0x00401230 --why
  tools/decomp candidates --stubs --limit 10
  tools/decomp candidates Nu3D --leaves --why
  tools/decomp discover
  tools/decomp discover --all
  tools/decomp defer 0x00401230 --kind layout --blocked-by 0x00405670 \
    --reason "needs the producer layout"
  tools/decomp evidence 0x00403640
  tools/decomp evidence --unmapped 0x00403640
  tools/decomp evidence 0x00403640 --disasm
  tools/decomp evidence 0x00403640 --decomp-range 80:160
  tools/decomp evidence 0x00403640 --full

`score` avoids the assembly diff when you only need the percentage:
  tools/decomp score 0x00403640 0x004B99F0

A non-meta campaign uses the doctor, two independent read-only scout audits,
and a doctor-bound brief before campaign measurement:
  # Fetch and integrate origin/agent/continuous before candidate selection.
  tools/decomp candidates --for 0x00403640 --lane closure --limit 1 \
    --prediction-features-out build/decomp-cache/prediction-handoff.json --why
  tools/decomp doctor --mode refinement --lane closure \
    --target 0x00403640 --selection-started-at UTC_TIMESTAMP --json
  # Scout A audits retail ABI, control flow, and evidence. Scout B audits
  # callers, types, layouts, translation-unit evidence, and analogues.
  tools/decomp brief --lane closure --target 0x00403640 \
    --doctor-receipt build/decomp-cache/doctor/latest.json \
    --scout-report build/decomp-cache/retail-scout.json \
    --scout-report build/decomp-cache/context-scout.json --json
  tools/decomp campaigns start --mode refinement --address 0x00403640 \
    --lane closure --subsystem Animation \
    --prediction-handoff build/decomp-cache/prediction-handoff.json \
    --doctor-receipt build/decomp-cache/doctor/latest.json --brief BRIEF_PATH
  tools/decomp campaigns status

Each scout returns a schema-2 JSON file. Use distinct scout IDs and exactly the
schema, scout_id, audit, lane, target, access, owns_mutations, doctor_receipt,
and findings keys. Each finding has only category, claim, and evidence. Each
evidence item has only source and locator. Set access to read-only and
owns_mutations to false. Use the
retail-abi-control-flow-evidence and callers-types-layout-translation-unit-analogue
audits, distinct scout IDs, and nonempty findings. The doctor_receipt object has
only receipt_id and sha256. Bind both reports to the canonical doctor identity.
Keep the doctor artifacts, scout reports, and brief unchanged. Finalization
revalidates them and rejects a HEAD change after the doctor.

The closure and production features JSON must contain success_probability,
cohort_sample_size, median_retained_bytes, and median_minutes. The two expected
values must equal the median values. Use the lower bound for stop decisions.
Other non-meta lanes need a nonempty features JSON, a version, both median
values, and a lower bound. A selector output file is directly valid for
--prediction-handoff. The start command validates its schema, lane, mode, and
address. Pass the file directly; do not rebuild it with jq. Do not mix it with
individual forecast options. A closure or production bundle needs one distinct
selector export for each address. Repeat --prediction-handoff in address order.
Use individual forecast options for resource, data, or research work without a
selector export. For multi-target source work, prediction features need a
per_target object keyed by every exact address. Start creates this object from
the repeated selector handoffs for closure and production. Each entry needs
median_retained_bytes and lower_retained_bytes. The target medians must sum to
the campaign median.
Add --json only when candidate output is also needed on stdout.
The start wrapper does not run the doctor or create the brief. It requires the
explicit receipt and one brief per ordered target.
The doctor receipt expires 60 minutes after the doctor ends. Run the exact
preflight again after expiry.
Use refinement for closure and production. Use coverage for research with a
STUB or unstarted target that has a specific blocker. Use refinement for an
implemented FUNCTION with a specific blocker or a valid selector cooldown or
circuit route. The brief and campaign start recompute this route. Use data for
data and resource for resource. Invalid pairs fail before costly preflight.

Production selection reads the sealed canonical report. After target
selection, run tools/decomp bc ADDRESS before the doctor and brief. This
creates the target-local, hash-bound verbose mismatch. The doctor and brief
reject stale mismatch evidence.

Evidence-only research occurs before measurement. A timed research campaign is
a coverage or refinement source pilot, based on the target state, with a ready
doctor-bound brief:
  tools/decomp campaigns start --mode coverage --address 0x00465180 \
    --lane research --subsystem SUBSYSTEM --expected-minutes MEDIAN_MINUTES \
    --expected-retained-bytes MEDIAN_BYTES --prediction-version cohort-v1 \
    --prediction-lower-bound-bytes LOWER_BYTES \
    --prediction-features build/decomp-cache/research-prediction.json \
    --doctor-receipt build/decomp-cache/doctor/latest.json --brief BRIEF_PATH

Stamp preflight and get the first score by their absolute deadlines. Start
finalization by the stop deadline, or by the displayed extension deadline when
the forecast is at least 100 retained bytes. The finalizer rejects a late source
result. It also rejects symbolic-link inputs and configured non-generated
sources that are absent from the staged Git tree.

Resource work uses the same preflight and the standard finalizer:
  tools/decomp doctor --mode resource --lane resource --resource 2,127,2057 \
    --selection-started-at UTC_TIMESTAMP --json
  # Run the two required scout audits and save their bound reports.
  tools/decomp brief --lane resource --target 2,127,2057 \
    --doctor-receipt build/decomp-cache/doctor/latest.json \
    --scout-report build/decomp-cache/retail-scout.json \
    --scout-report build/decomp-cache/context-scout.json --json
  tools/decomp campaigns start --mode resource --resource 2,127,2057 \
    --lane resource --expected-minutes MEDIAN_MINUTES \
    --expected-retained-bytes MEDIAN_BYTES --prediction-version resource-v1 \
    --prediction-lower-bound-bytes LOWER_BYTES \
    --prediction-features build/decomp-cache/resource-prediction.json \
    --doctor-receipt build/decomp-cache/doctor/latest.json \
    --brief RESOURCE_BRIEF
  tools/decomp finalize --result source --mode resource \
    --resource 2,127,2057 --staged

For no-source, restore all source trials and keep --staged on finalization:
  tools/decomp finalize --result no-source --mode MODE \
    --target ADDRESS --staged
  tools/decomp campaigns record --result no-source \
    --model "The tested loop form scored 20 percent."
Repeat --target for all active addresses in order. Use --resource for resource
work.

A meta campaign is one bounded workflow repair that blocks reliable source
progress. It skips candidates, the doctor, scouts, and brief.
It has no forecast or source deadlines after start. The fault does not have to
block every source queue:
  tools/decomp campaigns start --mode meta --lane meta
  tools/decomp finalize --result meta-fix --mode meta --staged
  tools/decomp campaigns record --result meta-fix

The leaf oracle runs a finite, allowlisted IA-32 check. It does not execute
native code and does not claim semantic equivalence:
  tools/decomp oracle list
  tools/decomp oracle run --target 0x004B0740
  tools/decomp oracle verify --receipt RECEIPT --current --require-pass
Plain verify checks the stored document. --current or --require-pass repeats
the check with the current inputs. New coverage and refinement source
finalization runs and freezes this check automatically.

Record the result after finalization. Add staged. A new coverage or refinement
source result requires a sealed independent impact review. The reviewer edits
all decision and status fields after review. Keep the exact generated
citations:
  tools/decomp campaigns record --result source
  tools/decomp campaigns delivery --campaign-id ID --status staged
  tools/decomp impact template --finalize-receipt RECEIPT \
    --reviewer-id REVIEWER --json > build/decomp-cache/review-pending.json
  # The independent reviewer edits review-pending.json.
  tools/decomp impact seal-review --finalize-receipt RECEIPT \
    --review-report build/decomp-cache/review-pending.json --json \
    > build/decomp-cache/review-sealed.json
  tools/decomp impact verify-review --finalize-receipt RECEIPT \
    --review-report build/decomp-cache/review-sealed.json --json
  tools/decomp campaigns delivery --campaign-id ID --status accepted \
    --review-report build/decomp-cache/review-sealed.json

The first reviewed acceptance rejects a missing report. An exact accepted
retry can omit the report and revalidates the cached review. A supplied retry
must use the same semantic report. Legacy, no-source, data, resource, and meta
results do not use this impact review.

Stage and commit the finalized files, campaign row, staged entry, and accepted
entry. Fetch and rebase that commit onto current origin/agent/continuous. Set
COMMIT to the resulting HEAD and BASE to its first parent. Then run:
  COMMIT=$(git rev-parse HEAD)
  BASE=$(git rev-parse HEAD^)
  DELIVERY_RECEIPT=$(
    tools/decomp campaigns delivery-verify --campaign-id ID \
      --commit "$COMMIT" --base-commit "$BASE" | \
      python -c 'import json, sys; print(json.load(sys.stdin)["path"])'
  )
  tools/decomp campaigns delivery --campaign-id ID --status integrated \
    --base-commit "$BASE" --commit "$COMMIT" \
    --delivery-receipt "$DELIVERY_RECEIPT"
  tools/decomp campaigns delivery --campaign-id ID --status committed \
    --commit "$COMMIT" --delivery-receipt "$DELIVERY_RECEIPT"
  # Push "$COMMIT" to origin/agent/continuous.
  tools/decomp campaigns delivery --campaign-id ID --status pushed \
    --commit "$COMMIT" --delivery-receipt "$DELIVERY_RECEIPT"
  tools/decomp campaigns abort --reason "The user stopped the campaign."
  tools/decomp campaigns evidence --address 0x00403640 --kind analogue \
    --failed-campaign-id FAILED_ID --failed-model "rejected loop form" \
    --changed-source "A retail sibling now supplies the loop form." \
    --note "Use the new sibling evidence for one bounded retry."

The delivery receipt rejects a conflict on a finalized campaign path. Source
delivery rebuilds and validates. Meta delivery runs focused tool
tests. No-source delivery checks the tree, index, and exact ledger and model-note
append. Do not build, create a report, or run Ghidra sync for no-source.

The pushed command verifies that the remote contains COMMIT. Put integrated,
committed, and pushed in one telemetry-only follow-up commit, then push it.
These entries stay outside the campaign commit. This follow-up commit does not
count as source progress. Do not reuse a receipt after HEAD, BASE, an input, or
an artifact changes. A rejected entry ends delivery.

Before a pivot, restore the current target trials. Run the doctor and two scout
audits for only the new address. Create its doctor-bound brief, then add it.
  tools/decomp candidates --lane production --limit 1 --for 0x004038E0 \
    --prediction-features-out build/decomp-cache/prediction-handoff.json --why
  tools/decomp bc 0x004038E0
  tools/decomp doctor --mode refinement --lane production --target 0x004038E0 \
    --selection-started-at PIVOT_SELECTION_UTC --json
  # Run two independent read-only scout audits with this doctor receipt.
  tools/decomp brief --lane production --target 0x004038E0 \
    --doctor-receipt PIVOT_RECEIPT \
    --scout-report build/decomp-cache/pivot-retail-scout.json \
    --scout-report build/decomp-cache/pivot-context-scout.json --json
  tools/decomp campaigns add-target --address 0x004038E0 \
    --replace OLD_ADDRESS \
    --prediction-handoff build/decomp-cache/prediction-handoff.json \
    --doctor-receipt PIVOT_RECEIPT --brief PIVOT_BRIEF

A family expansion omits --replace. Each new member still needs a fresh doctor
receipt, brief, and forecast. Prediction events preserve each target forecast.
The original campaign deadlines do not reset.

Routine output is bounded. `candidates` and `discover` show 10 rows.
`blockers` shows 20 rows. Use `--limit 0` or `--all` for all rows.
`evidence` shows 12 rows per category and 120 decompilation lines. Use
`--full` for all evidence. `bc` saves the complete diff in
build/decomp-diffs and prints three mismatch windows. Use `bc --full` or
`compare --verbose` for the complete comparison. `notes` shows eight matches.

`lint` measures source plausibility, which the comparison cannot see. An exact
match that still states byte offsets is a transliteration, not a
reconstruction:
  tools/decomp lint                 # all of src/
  tools/decomp lint --staged        # only what you are about to commit
  tools/decomp lint --show all      # include the reviewed legacy backlog
  tools/decomp lint --explain RULE  # rationale and required source form
  tools/decomp lint --format json   # structured findings for other tools

Reviewed old findings are in .notes/lint-baseline.tsv. They remain visible but
do not stop unrelated work. New errors and stale baseline rows fail the gate.
See .notes/lint-rules.md for the rule and suppression policy.

`names` regenerates .notes/original-names.md, the developers' own structure and
field names recovered from the retail assert strings. Those names outrank any
name you would invent.

`sync` runs reccmp's headless Ghidra importer (`reccmp-ghidra-import`) against
the local Ghidra project. Extra arguments are forwarded to the importer, e.g.
  tools/decomp sync --debug
The Ghidra project location is read from the `ghidra` CLI configuration.

TOY2_BUILD_JOBS sets the build parallelism for one command. The default is 4.
Set TOY2_LOCAL_BUILD_JOBS in .decomp-local for this checkout. See
docs/linux-decomp.md.
EOF
}

command="${1:-}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command" in
    help|-h|--help|"")
        usage
        exit 0
        ;;
    report)
        if [[ $# -eq 1 && ($1 == -h || $1 == --help) ]]; then
            echo "Usage: tools/decomp report [output.html]"
            exit 0
        fi
        ;;
    context)
        exec "$ROOT/.tooling/venv/bin/python" tools/decomp_context.py "$@"
        ;;
    impact)
        exec "$ROOT/.tooling/venv/bin/python" -m tools.decomp_impact "$@"
        ;;
    oracle)
        exec "$ROOT/.tooling/venv/bin/python" -m tools.decomp_oracle "$@"
        ;;
esac

source tools/linux-decomp-env.sh

prune_ghidra_logs() {
    python -c \
        'from pathlib import Path; from tools.decomp_doctor import prune_ghidra_logs; prune_ghidra_logs(Path.cwd())' \
        >/dev/null 2>&1 || true
}
trap prune_ghidra_logs EXIT

case "$command" in
    doctor)
        python tools/decomp_doctor.py "$@"
        ;;
    brief)
        python tools/decomp_brief.py "$@"
        ;;
    finalize)
        python tools/decomp_campaigns.py finalize "$@"
        ;;
    discover)
        python tools/decomp_discover.py "$@"
        ;;
    candidates)
        for candidate_argument in "$@"; do
            if [[ $candidate_argument == -h || $candidate_argument == --help ]]; then
                exec python tools/decomp_candidates.py "$@"
            fi
        done
        ensure_candidate_report
        exec python tools/decomp_candidates.py "$@"
        ;;
    campaigns)
        for campaign_argument in "$@"; do
            if [[ $campaign_argument == -h || $campaign_argument == --help ]]; then
                exec python tools/decomp_campaigns.py "$@"
            fi
        done
        campaign_action=""
        campaign_global_arguments=()
        campaign_arguments=("$@")
        campaign_index=0
        while [[ $campaign_index -lt ${#campaign_arguments[@]} ]]; do
            campaign_argument="${campaign_arguments[$campaign_index]}"
            case "$campaign_argument" in
                --state-file)
                    if [[ $((campaign_index + 1)) -ge ${#campaign_arguments[@]} ]]; then
                        exec python tools/decomp_campaigns.py "$@"
                    fi
                    campaign_global_arguments+=(
                        "$campaign_argument"
                        "${campaign_arguments[$((campaign_index + 1))]}"
                    )
                    campaign_index=$((campaign_index + 2))
                    ;;
                --state-file=*)
                    campaign_global_arguments+=("$campaign_argument")
                    campaign_index=$((campaign_index + 1))
                    ;;
                --file|--source-models|--functions-map|--function-sizes|--worktree-root|--source-root)
                    if [[ $((campaign_index + 1)) -ge ${#campaign_arguments[@]} ]]; then
                        exec python tools/decomp_campaigns.py "$@"
                    fi
                    campaign_global_arguments+=(
                        "$campaign_argument"
                        "${campaign_arguments[$((campaign_index + 1))]}"
                    )
                    campaign_index=$((campaign_index + 2))
                    ;;
                --file=*|--source-models=*|--functions-map=*|--function-sizes=*|--worktree-root=*|--source-root=*)
                    campaign_global_arguments+=("$campaign_argument")
                    campaign_index=$((campaign_index + 1))
                    ;;
                *)
                    campaign_action="$campaign_argument"
                    break
                    ;;
            esac
        done
        case "$campaign_action" in
            start)
                campaign_mode=""
                campaign_lane=""
                campaign_targets=()
                campaign_resource=""
                campaign_doctor_receipt=""
                campaign_briefs=()
                campaign_scan_index=0
                while [[ $campaign_scan_index -lt ${#campaign_arguments[@]} ]]; do
                    campaign_scan_argument="${campaign_arguments[$campaign_scan_index]}"
                    case "$campaign_scan_argument" in
                        --mode|--lane|--address|--resource|--doctor-receipt|--brief)
                            if [[ $((campaign_scan_index + 1)) -lt ${#campaign_arguments[@]} ]]; then
                                campaign_scan_value="${campaign_arguments[$((campaign_scan_index + 1))]}"
                                case "$campaign_scan_argument" in
                                    --mode) campaign_mode="$campaign_scan_value" ;;
                                    --lane) campaign_lane="$campaign_scan_value" ;;
                                    --address) campaign_targets+=("$campaign_scan_value") ;;
                                    --resource) campaign_resource="$campaign_scan_value" ;;
                                    --doctor-receipt) campaign_doctor_receipt="$campaign_scan_value" ;;
                                    --brief) campaign_briefs+=("$campaign_scan_value") ;;
                                esac
                            fi
                            campaign_scan_index=$((campaign_scan_index + 1))
                            ;;
                        --mode=*) campaign_mode="${campaign_scan_argument#*=}" ;;
                        --lane=*) campaign_lane="${campaign_scan_argument#*=}" ;;
                        --address=*) campaign_targets+=("${campaign_scan_argument#*=}") ;;
                        --resource=*) campaign_resource="${campaign_scan_argument#*=}" ;;
                        --doctor-receipt=*) campaign_doctor_receipt="${campaign_scan_argument#*=}" ;;
                        --brief=*) campaign_briefs+=("${campaign_scan_argument#*=}") ;;
                    esac
                    campaign_scan_index=$((campaign_scan_index + 1))
                done
                if [[ -z $campaign_mode ]]; then
                    exec python tools/decomp_campaigns.py "$@"
                fi
                if [[ -z $campaign_lane ]]; then
                    case "$campaign_mode" in
                        coverage) campaign_lane="research" ;;
                        refinement) campaign_lane="production" ;;
                        *) campaign_lane="$campaign_mode" ;;
                    esac
                fi
                if [[ $campaign_mode != meta ]]; then
                    if [[ -z $campaign_doctor_receipt ]]; then
                        echo "error: a $campaign_mode campaign needs an explicit --doctor-receipt" >&2
                        exit 2
                    fi
                    campaign_brief_count=${#campaign_targets[@]}
                    if [[ $campaign_mode == resource ]]; then
                        campaign_brief_count=1
                    fi
                    if [[ ${#campaign_briefs[@]} -ne $campaign_brief_count ]]; then
                        echo "error: a $campaign_mode campaign needs one --brief for each ordered target" >&2
                        exit 2
                    fi
                fi
                campaign_progress="build/decomp-cache/campaign-progress-before.json"
                mkdir -p build/decomp-cache
                python decomp_utils.py --progress --json > "$campaign_progress"
                campaign_arguments+=(--progress-before "$campaign_progress")
                python tools/decomp_campaigns.py "${campaign_arguments[@]}"
                if [[ $campaign_mode == meta ]]; then
                    if ! python tools/decomp_campaigns.py \
                        "${campaign_global_arguments[@]}" set-meta-baseline \
                        --progress "$campaign_progress" --quiet; then
                        python tools/decomp_campaigns.py "${campaign_global_arguments[@]}" abort \
                            --reason "The meta campaign baseline attachment failed."
                        exit 1
                    fi
                else
                    if ! baseline; then
                        python tools/decomp_campaigns.py "${campaign_global_arguments[@]}" abort \
                            --reason "The campaign baseline command failed."
                        exit 1
                    fi
                    if ! python tools/decomp_campaigns.py \
                        "${campaign_global_arguments[@]}" set-baseline \
                        --progress "$campaign_progress" --quiet; then
                        python tools/decomp_campaigns.py "${campaign_global_arguments[@]}" abort \
                            --reason "The campaign baseline attachment failed."
                        exit 1
                    fi
                fi
                ;;
            record)
                exec python tools/decomp_campaigns.py "$@"
                ;;
            *)
                exec python tools/decomp_campaigns.py "$@"
                ;;
        esac
        ;;
    defer)
        if [[ $# -lt 3 ]]; then
            echo "Usage: tools/decomp defer <address> [--blocked-by <address> ...] --reason <text>" >&2
            exit 2
        fi
        address="$1"
        shift
        exec python tools/decomp_candidates.py --record-deferral "$address" "$@"
        ;;
    undefer)
        if [[ $# -ne 1 ]]; then
            echo "Usage: tools/decomp undefer <address>" >&2
            exit 2
        fi
        exec python tools/decomp_candidates.py --clear-deferral "$1"
        ;;
    blockers)
        address=""
        if [[ $# -gt 0 && $1 != --* ]]; then address="$1"; shift; fi
        exec python tools/decomp_candidates.py --list-blockers "$address" "$@"
        ;;
    evidence)
        python tools/decomp_evidence.py "$@"
        ;;
    notes)
        exec python tools/decomp_notes.py "$@"
        ;;
    lint)
        exec python tools/decomp_lint.py "$@"
        ;;
    names)
        exec python tools/decomp_original_names.py "$@"
        ;;
    configure)
        configure "$@"
        ;;
    build)
        build "$@"
        ;;
    compare)
        ensure_build
        (cd build && reccmp-reccmp --target TOY2 "$@")
        ;;
    score)
        score "$@"
        ;;
    bc)
        full=0
        bc_args=()
        for argument in "$@"; do
            if [[ $argument == "--full" ]]; then full=1; else bc_args+=("$argument"); fi
        done
        set -- "${bc_args[@]}"
        if [[ $# -ne 1 ]]; then
            echo "Usage: tools/decomp bc [--full] <address>" >&2
            exit 2
        fi
        if [[ ! $1 =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
            echo "error: bc needs an address such as 0x00401230" >&2
            exit 2
        fi
        printf -v canonical_address '0x%08X' "$1"
        build_game
        ensure_candidate_report
        mkdir -p build/decomp-diffs
        diff_path="build/decomp-diffs/${canonical_address}.txt"
        (cd build && reccmp-reccmp --target TOY2 --no-color --verbose "$canonical_address") > "$diff_path"
        python tools/decomp_provenance.py seal-diff "$diff_path" \
            --address "$canonical_address" --report build/decomp-current-report.json >/dev/null
        diff_args=(
            "$diff_path"
            --address "$canonical_address"
            --functions-map tools/Resources/functions_map.txt
            --function-sizes build/decomp-function-sizes.json
            --source-root src
        )
        if [[ $full -eq 1 ]]; then
            python tools/decomp_diff.py "${diff_args[@]}" --full
        else
            python tools/decomp_diff.py "${diff_args[@]}"
        fi
        if [[ -f build/decomp-campaign-state.json ]]; then
            python tools/decomp_campaigns.py first-score \
                --address "$canonical_address" \
                --diff "$diff_path" \
                --score-functions-map tools/Resources/functions_map.txt \
                --score-function-sizes build/decomp-function-sizes.json \
                --score-source-root src \
                --quiet
        fi
        ;;
    baseline)
        baseline "$@"
        ;;
    validate)
        validate "$@"
        ;;
    experiment)
        experiment "$@"
        ;;
    replay)
        exec python tools/decomp_replay.py "$@"
        ;;
    route)
        exec python tools/decomp_route.py "$@"
        ;;
    report)
        report "$@"
        ;;
    data)
        for argument in "$@"; do
            if [[ $argument == -h || $argument == --help ]]; then
                exec python tools/decomp_data.py --help
            fi
        done
        ensure_build
        write_data_report decomp-current-data-report.json
        python tools/decomp_data.py "$@"
        for argument in "$@"; do
            if [[ $argument =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
                python tools/decomp_campaigns.py first-score \
                    --address "$argument" \
                    --data-report build/decomp-current-data-report.json \
                    --quiet
            fi
        done
        ;;
    session-summary)
        if [[ $# -eq 0 ]]; then
            echo "Usage: tools/decomp session-summary <address> [address...]" >&2
            exit 2
        fi
        exec python tools/decomp_verify.py session-summary \
            build/decomp-baseline-report.json build/decomp-current-report.json "$@"
        ;;
    progress)
        if [[ ${1:-} == "--json" ]]; then
            shift
            if [[ $# -gt 1 ]]; then echo "Usage: tools/decomp progress [--json] [namespace]" >&2; exit 2; fi
            if [[ $# -eq 1 ]]; then
                python decomp_utils.py --progress "$1" --json
            else
                python decomp_utils.py --progress --json
            fi
        elif [[ $# -gt 1 ]]; then
            echo "Usage: tools/decomp progress [--json] [namespace]" >&2
            exit 2
        elif [[ $# -eq 1 ]]; then
            python decomp_utils.py --progress "$1"
        else
            python decomp_utils.py --progress
        fi
        ;;
    check)
        python tools/ghidra_sync.py check "$@"
        ;;
    run)
        ensure_build
        exec wine build/toy2.exe "$@"
        ;;
    shell)
        exec "${SHELL:-/bin/bash}" -i
        ;;
    sync)
        python tools/ghidra_sync.py sync "$@"
        ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
