#!/usr/bin/env bash
# commit-msg hook: a tooling-only commit must cite a task id and keep the
# anti-regrowth tests green. Enable with: git config core.hooksPath tools/hooks
set -u

message_file="$1"
root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0
python="/run/media/skelp/1TB/venvs/toy2-decomp/.tooling/venv/bin/python"
[[ -x $python ]] || python=python3

staged="$(git diff --cached --name-only)"
tooling='^(tools/|AGENTS\.md$|CLAUDE\.md$|\.agents/|docs/|ROADMAP\.md$|\.github/)'
source='^(src/|tools/Resources/(functions_map\.txt|campaign-ledger\.jsonl|scoreboard\.tsv)$)'

# Source commits are never checked, and mixed source+tooling commits pass.
grep -Eq "$tooling" <<<"$staged" || exit 0
grep -Eq "$source" <<<"$staged" && exit 0

fail() {
    echo "commit-msg: $1" >&2
    exit 1
}

if ! grep -vE '^#' "$message_file" | grep -Eq '\[T-[0-9]{2,}\]'; then
    fail "a tooling-only commit must cite its task id, e.g. [T-12], in the message"
fi
# Tooling the user asked for is tagged [T-nn][user]: it skips the tooling cap,
# which exists to stop self-directed process work, but never the tests below.
user_requested=0
grep -vE '^#' "$message_file" | grep -Eq '\[T-[0-9]{2,}\]\[user\]' && user_requested=1
if [[ $user_requested -eq 0 ]] && grep -Eq '^[[:space:]]*throughput\)' tools/decomp; then
    tools/decomp throughput --cap-check \
        || fail "tools/decomp throughput --cap-check failed; the tooling budget is exceeded (tooling the user requested is tagged [T-nn][user])"
fi
"$python" -m unittest tools.tests.test_normative_inputs -q \
    || fail "tools/tests/test_normative_inputs.py failed; fix the contract or tooling first"
