#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ -f .decomp-local ]]; then
    source .decomp-local
fi

build_jobs="${TOY2_BUILD_JOBS:-${TOY2_LOCAL_BUILD_JOBS:-4}}"
# validate fingerprints the tree its current reports describe; finish and baseline
# reuse those reports only while the fingerprint still matches.
report_stamp="build/decomp-report-stamp.json"
both_reports=(--report build/decomp-current-report.json --report build/decomp-current-data-report.json)

# A driver run (DECOMP_RUN_EVENTS) logs each step of finish and validate as a quiet
# phase event, so that throughput --runs can time the steps.
run_step() {
    [[ -z ${DECOMP_RUN_EVENTS:-} ]] || python tools/decomp_attempts.py event phase "phase $1" \
        --field "phase=$1" --set "phase=$1" --state --quiet || true
}

configure() {
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_SYSTEM_NAME=Windows \
        -DCMAKE_C_COMPILER=cl \
        -DCMAKE_CXX_COMPILER=cl \
        -DCMAKE_RC_COMPILER=rc \
        -DCMAKE_C_DEPFILE_FORMAT=msvc \
        -DCMAKE_DEPFILE_FLAGS_C=/showIncludes \
        -DCMAKE_CXX_DEPFILE_FORMAT=msvc \
        -DCMAKE_DEPFILE_FLAGS_CXX=/showIncludes
}

build() {
    if [[ ! -f build/build.ninja ]]; then
        configure || return
    fi
    cmake --build build -- "-j${build_jobs}" || return
    (
        cd build
        reccmp-project detect --what recompiled 2> >(grep -v '^\[INFO\]' >&2)
    ) || return
}

# Run one build with its output captured to build/decomp-diffs/build.log so
# only diagnostics and a one-line verdict reach the writer.
build_quietly() {
    local log="build/decomp-diffs/build.log"
    local started=$SECONDS
    local status=0
    mkdir -p build/decomp-diffs
    "$@" > "$log" 2>&1 || status=$?
    grep -E ' error |fatal error|build stopped|error LNK' "$log" >&2 || true
    if [[ $status -ne 0 ]]; then
        echo "build: FAILED, see $log" >&2
        return "$status"
    fi
    echo "build: OK ($((SECONDS - started)) s)"
}

# The reccmp "[INFO] Found ..." lines carry no signal for a writer, so only
# warnings and errors reach the terminal.
build_game() {
    if [[ ! -f build/build.ninja ]]; then
        configure || return
    fi
    build_quietly cmake --build build --target toy2decomp -- "-j${build_jobs}" || return
    (
        cd build
        reccmp-project detect --what recompiled 2> >(grep -v '^\[INFO\]' >&2)
    ) || return
}

# Print only the per-function similarity verdict for each given address. One
# PDB parse serves every address, and no assembly diff reaches the caller.
score() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: tools/decomp score <address> [address...]" >&2
        return 2
    fi
    for argument in "$@"; do
        if [[ $argument == -h || $argument == --help ]]; then
            python tools/decomp_verify.py score --help
            return
        fi
    done
    ensure_build
    write_comparison_report decomp-score-report.json
    python tools/decomp_verify.py score build/decomp-score-report.json "$@"
    for address in "$@"; do
        if [[ $address =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
            python tools/decomp_campaigns.py first-score --address "$address" --quiet
        fi
    done
}

ensure_build() {
    build_game
}

write_comparison_report() {
    local output_name="$1"
    (
        cd build
        reccmp-reccmp --target TOY2 --silent --no-color --json "$output_name" \
            2> >(grep -v '^\[INFO\]' >&2)
    ) >/dev/null
}

write_data_report() {
    local output_name="$1"
    python tools/generate-decomp-data-report.py \
        --original original/toy2.exe \
        --recompiled build/toy2.exe \
        --pdb build/toy2.pdb \
        --source-root src \
        --output "build/$output_name"
}

function_sizes_are_valid() {
    python -c \
        'import sys; from pathlib import Path; from tools.ghidra_sync import _read_snapshot_sizes; _read_snapshot_sizes(Path(sys.argv[1]))' \
        "$1" >/dev/null 2>&1
}

refresh_function_sizes() {
    local function_sizes="build/decomp-function-sizes.json"
    local temporary_sizes="build/decomp-function-sizes.json.tmp"
    if command -v ghidra >/dev/null 2>&1; then
        if ghidra function list --json --limit 0 --fields address,size > "$temporary_sizes" && \
            function_sizes_are_valid "$temporary_sizes"; then
            mv "$temporary_sizes" "$function_sizes" || return
        else
            rm -f "$temporary_sizes"
            echo "warning: kept the existing function-size snapshot" >&2
        fi
    else
        echo "warning: Ghidra is unavailable; kept the existing function-size snapshot" >&2
    fi
    if ! function_sizes_are_valid "$function_sizes"; then
        echo "error: no valid retail function-size snapshot is available" >&2
        return 1
    fi
}

baseline() {
    if [[ $# -gt 0 ]]; then
        for argument in "$@"; do
            if [[ $argument == -h || $argument == --help ]]; then
                echo "Usage: tools/decomp baseline"
                return
            fi
        done
        echo "error: baseline does not accept arguments" >&2
        return 2
    fi
    build || return
    # The reports of the last validate describe this tree while their stamp matches
    # (HEAD, index, src, build outputs, toolchain): copy them instead of a new run.
    if python tools/decomp_verify.py stamp "$report_stamp" --check "${both_reports[@]}" > /dev/null 2>&1; then
        cp -f build/decomp-current-report.json build/decomp-baseline-report.json || return
        cp -f build/decomp-current-data-report.json build/decomp-baseline-data-report.json || return
        echo "baseline: reused the reports of the last validate (stamp matches)"
    else
        write_comparison_report decomp-baseline-report.json || return
        write_data_report decomp-baseline-data-report.json || return
    fi
    refresh_function_sizes || return
    python tools/decomp_verify.py metadata build/decomp-baseline-meta.json \
        --report build/decomp-baseline-report.json \
        --data-report build/decomp-baseline-data-report.json || return
    local revision
    revision=$(git rev-parse --short HEAD) || return
    echo "Wrote build/decomp-baseline-report.json for $revision."
}

campaign_state_is_finalizing() {
    local state_path="$1"
    [[ -f $state_path ]] || return 1
    python -c \
        'import json,sys; sys.exit(0 if json.load(open(sys.argv[1], encoding="utf-8")).get("phase") == "finalizing" else 1)' \
        "$state_path" >/dev/null 2>&1
}

validate() {
    local accounting_correction=""
    local allow_target_regression=0
    local meta_resolution=0
    local mode=""
    local resource=""
    local staged=0
    local targets=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 ]] || { echo "error: --target needs an address" >&2; return 2; }
                targets+=("$2")
                shift 2
                ;;
            --allow-target-regression)
                allow_target_regression=1
                shift
                ;;
            --mode)
                [[ $# -ge 2 ]] || {
                    echo "error: --mode needs a campaign type" >&2
                    return 2
                }
                mode="$2"
                shift 2
                ;;
            --resource)
                [[ $# -ge 2 ]] || {
                    echo "error: --resource needs TYPE,ID,LANGUAGE" >&2
                    return 2
                }
                resource="$2"
                shift 2
                ;;
            --accounting-correction)
                [[ $# -ge 2 ]] || {
                    echo "error: --accounting-correction needs a reason" >&2
                    return 2
                }
                accounting_correction="$2"
                shift 2
                ;;
            --meta-resolution)
                meta_resolution=1
                shift
                ;;
            --staged)
                staged=1
                shift
                ;;
            *)
                echo "error: unknown validate argument: $1" >&2
                return 2
                ;;
        esac
    done
    if [[ $mode != resource && ${#targets[@]} -eq 0 ]]; then
        echo "error: validate needs at least one --target address" >&2
        return 2
    fi
    if [[ -n $mode && $mode != coverage && $mode != refinement && $mode != data && $mode != resource ]]; then
        echo "error: unknown validation mode: $mode" >&2
        return 2
    fi
    if [[ $mode == resource && ${#targets[@]} -gt 0 ]]; then
        echo "error: a resource campaign cannot have target addresses" >&2
        return 2
    fi
    if [[ $mode == resource && -z $resource ]]; then
        echo "error: a resource campaign needs exactly one --resource" >&2
        return 2
    fi
    if [[ $mode != resource && -n $resource ]]; then
        echo "error: --resource requires --mode resource" >&2
        return 2
    fi
    if [[ $meta_resolution -eq 0 && -z $mode ]]; then
        echo "error: validate needs --mode coverage, refinement, or data" >&2
        return 2
    fi
    if [[ $mode == data && ${#targets[@]} -gt 3 ]]; then
        echo "error: a data campaign can have at most three targets" >&2
        return 2
    fi
    if [[ $allow_target_regression -eq 1 && $meta_resolution -eq 0 ]]; then
        echo "error: --allow-target-regression requires --meta-resolution" >&2
        return 2
    fi
    if [[ -n $accounting_correction && $meta_resolution -eq 0 ]]; then
        echo "error: --accounting-correction requires --meta-resolution" >&2
        return 2
    fi
    if [[ -n $accounting_correction && $mode != data ]]; then
        echo "error: --accounting-correction requires --mode data" >&2
        return 2
    fi
    if [[ ! -f build/decomp-baseline-report.json ]]; then
        echo "error: run tools/decomp baseline before you edit source" >&2
        return 2
    fi
    if [[ ( $mode == data || $mode == resource ) && ! -f build/decomp-baseline-data-report.json ]]; then
        echo "error: run tools/decomp baseline before a data campaign" >&2
        return 2
    fi
    if [[ $mode == data && $staged -eq 1 && -z $accounting_correction ]] && \
        git diff --cached --quiet -- src; then
        echo "error: a staged data campaign must change the source tree" >&2
        return 2
    fi

    run_step build
    build_game || return
    # patcher.dll builds the same sources with APPLY_FIXES and no report reads it, so it
    # builds beside the reports and checks. validate waits for it on every path.
    local patcher_log=build/decomp-diffs/patcher-build.log patcher_pid status=0
    cmake --build build --target patcher -- "-j${build_jobs}" > "$patcher_log" 2>&1 &
    patcher_pid=$!
    validate_checks || status=$?
    run_step patcher
    if ! wait "$patcher_pid"; then
        grep -E ' error |fatal error|error LNK' "$patcher_log" >&2 || true
        echo "error: patcher.dll does not build (log: $patcher_log)" >&2
        ((status)) || status=1
    fi
    return "$status"
}

# The reports and checks of validate. It reads the options of validate, its caller.
validate_checks() {
    run_step reports
    # finish stamps the comparison report that it writes for the annotation tags. While
    # the build, src and the report inputs match the stamp, that report is still exact.
    if python tools/decomp_verify.py stamp "$report_stamp" --check --ignore-index \
        --report build/decomp-current-report.json > /dev/null 2>&1; then
        echo "validate: reused the comparison report of finish (stamp matches)"
    else
        write_comparison_report decomp-current-report.json || return
    fi
    rm -f "$report_stamp"
    local with_data_reports=0 stamped=(--report build/decomp-current-report.json)
    if [[ $mode == data || $mode == resource || -f build/decomp-baseline-data-report.json ]]; then
        write_data_report decomp-current-data-report.json || return
        with_data_reports=1 stamped=("${both_reports[@]}")
    fi
    # Fingerprint the tree these reports describe, so that the record step and the next
    # baseline can reuse them. A failed stamp costs only the reuse.
    python tools/decomp_verify.py stamp "$report_stamp" "${stamped[@]}" || rm -f "$report_stamp"
    local verify_args=(
        validate
        build/decomp-baseline-report.json
        build/decomp-current-report.json
        "${targets[@]}"
        --metadata build/decomp-baseline-meta.json
    )
    if [[ $allow_target_regression -eq 1 ]]; then
        verify_args+=(--allow-target-regression)
    fi
    if [[ $meta_resolution -eq 1 ]]; then
        verify_args+=(--meta-resolution)
    fi
    if [[ $staged -eq 1 ]]; then
        verify_args+=(--staged)
    fi
    if [[ -n $mode ]]; then
        verify_args+=(--mode "$mode")
    fi
    if [[ -n $resource ]]; then
        verify_args+=(--resource "$resource")
    fi
    if [[ $with_data_reports -eq 1 ]]; then
        verify_args+=(
            --baseline-data build/decomp-baseline-data-report.json
            --current-data build/decomp-current-data-report.json
        )
    fi
    if [[ -n $accounting_correction ]]; then
        verify_args+=(--accounting-correction "$accounting_correction")
    fi
    run_step verify
    python tools/decomp_verify.py "${verify_args[@]}" || return
    run_step scoreboard
    python tools/decomp_verify.py scoreboard build/decomp-current-report.json \
        tools/Resources/scoreboard.tsv --generated-by validate || return
    for target in "${targets[@]}"; do
        python tools/decomp_campaigns.py first-score --address "$target" --quiet || return
    done
    if [[ $mode == resource ]]; then
        python tools/decomp_campaigns.py resource-score --quiet || return
    fi
    run_step lint
    if [[ $staged -eq 1 ]]; then
        python tools/decomp_lint.py --staged --warnings-as-errors || return
    fi
    python tools/ghidra_sync.py check || return
    git diff --check
}

# Say which attempt a saved diff belongs to before a --hunks/--hunk/--compact view.
saved_diff_line() {
    local stats
    stats=$(python tools/decomp_attempts.py stats --address "$1" --json) || return 0
    python -c '
import json, sys
stats = json.loads(sys.argv[1])
if stats["last_raw"] is None:
    print("saved diff: no logged attempt for " + sys.argv[2])
else:
    print("saved diff: attempt {}, score {:.2f}%".format(stats["attempts"], stats["last_raw"]))
' "$stats" "$1" || true
}

# The orientation pack a fresh writer batch starts from, in one read: the
# handoff (or the evidence: its names for a refinement, the full decompilation
# for a STUB or unstarted target), the region index, then the largest regions with their source lines
# while the text stays under 24,000 characters, because a longer tool output is
# spilled to a file the writer must page through.
bc_pack() {
    local address=$1 diff_path=$2 budget=24000 text part skipped="" count=0
    local handoff="build/decomp-cache/handoff/$1.md" canonical file range first last path
    canonical=$(printf '0x%08X' "$((address))")
    if [[ -f $handoff ]]; then
        text="--- handoff $handoff ---"$'\n'"$(cat "$handoff")"
    elif grep -rqE "// FUNCTION: TOY2 $canonical\b" src; then
        # A refinement writer reads the source and the diff; of the evidence
        # only the names (strings and data) are worth the space.
        text="--- evidence $address (target, strings, data) ---"$'\n'"$("$0" evidence "$address" 2>/dev/null \
            | awk '/^== / {keep = /^== (target|referenced strings|referenced data)/} keep')"
    else
        text="--- evidence $address --full ---"$'\n'"$("$0" evidence "$address" --full 2>/dev/null | grep -v '^\[INFO\]')"
    fi
    text+=$'\n'"--- region index ---"$'\n'"$(saved_diff_line "$address")"
    text+=$'\n'"$(python tools/decomp_diff.py "$diff_path" --hunks)"
    while read -r _ number span; do
        part=$'\n'"$(python tools/decomp_diff.py "$diff_path" --hunk "$number")"
        file=${span%%:*}
        range=${span#*:}
        path=$(git ls-files -- "src/*$file" | grep -m1 "/$file$" || true)
        if [[ $span == *:* && -n $path ]]; then
            first=${range%%-*}
            last=${range##*-}
            first=$((first > 3 ? first - 3 : 1))
            part+=$'\n'"--- source $path:$first-$((last + 3)) ---"
            part+=$'\n'"$(sed -n "${first},$((last + 3))p" "$path")"
        fi
        if (( count >= 4 || ${#text} + ${#part} > budget )); then
            skipped+=" $number"
            continue
        fi
        text+=$part
        count=$((count + 1))
    done < <(python tools/decomp_diff.py "$diff_path" --hunks \
        | awk '/^ *[0-9]+ +0x/ {a=$3; b=$4; gsub(/[-+]/, "", a); gsub(/[-+]/, "", b); print a + b, $1, $5}' \
        | sort -rn | head -n 8)
    printf '%s\n' "$text"
    if [[ -n $skipped ]]; then
        echo "--- not included (tools/decomp bc $address --hunk N): regions$skipped ---"
    fi
}

# A dirty header can move functions the writer never touched. Show them at bc
# time instead of at validate. Information only, never a failure.
header_side_effects() {
    write_comparison_report decomp-score-report.json || return 0
    python tools/decomp_verify.py score --changed build/decomp-score-report.json \
        --baseline build/decomp-baseline-report.json --exclude "$1" || true
}

# Turn a coverage target's STUB annotation into a FUNCTION annotation.
promote_stub() {
    local address="$1"
    local path
    while IFS= read -r path; do
        sed -i "s|// STUB: TOY2 ${address}\b|// FUNCTION: TOY2 ${address} [PROVISIONAL]|" "$path" \
            || return
        echo "promoted: $path: STUB ${address} -> FUNCTION [PROVISIONAL]"
    done < <(grep -rl -- "// STUB: TOY2 ${address}\b" src || true)
}

finish_usage() {
    echo "Usage: tools/decomp campaigns finish --mode MODE --target ADDR [--target ADDR ...]" \
        "--note TEXT --message FILE"
}

# campaigns finish: promote STUBs, refresh tags, stage, validate --staged,
# record, commit, then forget the targets' handoff and attempt files. Every
# step is fatal with one line; a validate failure records nothing.
campaign_finish() {
    local mode="" note="" message="" target reason=""
    local targets=() target_args=() canonical=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) finish_usage; return 0 ;;
        esac
        if [[ $# -lt 2 ]]; then
            echo "error: finish argument $1 needs a value" >&2
            return 2
        fi
        case "$1" in
            --mode) mode="$2" ;;
            --note) note="$2" ;;
            --message) message="$2" ;;
            --target) targets+=("$2") ;;
            *) echo "error: unknown finish argument: $1" >&2; finish_usage >&2; return 2 ;;
        esac
        shift 2
    done
    if [[ $mode != coverage && $mode != refinement && $mode != data ]]; then
        echo "error: finish needs --mode coverage, refinement, or data" >&2
        return 2
    fi
    if [[ ${#targets[@]} -eq 0 ]]; then
        echo "error: finish needs at least one --target address" >&2
        return 2
    fi
    if [[ -z $note ]]; then
        echo "error: finish needs --note TEXT for the campaign record" >&2
        return 2
    fi
    if [[ -z $message || ! -s $message ]]; then
        echo "error: finish needs --message FILE holding the commit message" >&2
        return 2
    fi
    for target in "${targets[@]}"; do
        if [[ ! $target =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
            echo "error: finish needs addresses such as 0x00401230, not $target" >&2
            return 2
        fi
        canonical+=("$(printf '0x%08X' "$target")")
        target_args+=(--target "$target")
    done
    if [[ $mode == coverage ]]; then
        for target in "${canonical[@]}"; do
            promote_stub "$target" || { echo "error: STUB promotion of $target failed" >&2; return 1; }
        done
    fi
    if [[ $mode != data ]]; then
        run_step annotate
        # validate demands the tag fresh verification requires (MATCHED at
        # 100%, EFFECTIVE, else PROVISIONAL), so set it from a fresh report.
        build_game || { echo "error: the game build failed; finish stopped" >&2; return 1; }
        write_comparison_report decomp-current-report.json \
            || { echo "error: the comparison report failed; finish stopped" >&2; return 1; }
        # validate reuses this report when the tags, the build and src stay as they are.
        python tools/decomp_verify.py stamp "$report_stamp" --report build/decomp-current-report.json \
            || rm -f "$report_stamp"
        python tools/decomp_verify.py annotations build/decomp-current-report.json --write \
            || { echo "error: the annotation tags could not be refreshed" >&2; return 1; }
    fi
    git add src tools/Resources/functions_map.txt \
        || { echo "error: git add of the source tree failed" >&2; return 1; }
    # Debt the campaign removed leaves a stale baseline row, which validate rejects.
    # Prune from the committed rows, so a retried finish sees the debt of its own tree.
    git checkout -q HEAD -- .notes/lint-baseline.tsv \
        && python tools/decomp_lint.py --prune-baseline && git add .notes/lint-baseline.tsv \
        || { echo "error: the lint baseline could not be pruned" >&2; return 1; }
    local log="build/decomp-diffs/validate.log"
    mkdir -p build/decomp-diffs
    if ! validate --mode "$mode" "${target_args[@]}" --staged > "$log" 2>&1; then
        grep -vE '^\[[0-9]+/[0-9]+\] |: warning [A-Z]+[0-9]+:' "$log" | tail -n 30 || true
        echo "error: validate failed; nothing was recorded (full log: $log)" >&2
        return 1
    fi
    grep -E '^0x[0-9A-Fa-f]{8}  ' "$log" || true
    echo "validate: OK (log: $log)"
    run_step record
    # The record path of `campaigns record`: fresh reports, then the ledger row.
    # validate wrote the reports moments ago; its stamp proves whether HEAD, the
    # index, src, the build outputs and the reports are still the same.
    if ! campaign_state_is_finalizing "$campaign_state_file"; then
        build || { echo "error: the record build failed; nothing was recorded" >&2; return 1; }
        if reason=$(python tools/decomp_verify.py stamp "$report_stamp" --check "${both_reports[@]}"); then
            echo "record: reused the validate reports (stamp matches)"
        else
            echo "record: new reports (${reason#stamp: })"
            write_comparison_report decomp-current-report.json \
                || { echo "error: the record comparison report failed" >&2; return 1; }
            write_data_report decomp-current-data-report.json \
                || { echo "error: the record data report failed" >&2; return 1; }
        fi
    fi
    python tools/decomp_campaigns.py "${campaign_global_arguments[@]}" record \
        --result source --note "$note" \
        || { echo "error: campaigns record failed; nothing was committed" >&2; return 1; }
    git add tools/Resources/campaign-ledger.jsonl tools/Resources/scoreboard.tsv \
        || { echo "error: git add of the campaign records failed" >&2; return 1; }
    git commit -q -F "$message" || { echo "error: git commit failed" >&2; return 1; }
    # Move the stamp to the new commit, so that the next baseline can reuse the reports.
    python tools/decomp_verify.py stamp "$report_stamp" --advance > /dev/null || true
    # candidates ranks from the session report; give it the committed scores so
    # the next selection does not repeat the target it just finished.
    cp -f build/decomp-current-report.json build/decomp-report-data.json
    for target in "${canonical[@]}"; do
        rm -f "build/decomp-cache/handoff/${target}.md" "build/decomp-attempts/${target}.jsonl"
    done
    echo "finished: $(git rev-parse --short HEAD)"
}

# handoff ADDR: save stdin as the handoff of one target, so that the next
# batch's pack starts from it. The driver pipes a writer's final message into
# it; a model that runs a batch itself uses a quoted heredoc.
handoff() {
    if [[ $# -ne 1 || ! ${1:-} =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
        echo "Usage: tools/decomp handoff <address> <<'EOF' ... EOF" >&2
        return 2
    fi
    if [[ -t 0 ]]; then
        echo "error: handoff reads the text from stdin" >&2
        return 2
    fi
    local path
    path="build/decomp-cache/handoff/$(printf '0x%08X' "$1").md"
    mkdir -p build/decomp-cache/handoff || return
    cat > "$path.tmp" || return
    if [[ ! -s $path.tmp ]]; then
        rm -f "$path.tmp"
        echo "error: the handoff text is empty; nothing was written" >&2
        return 2
    fi
    mv -f "$path.tmp" "$path" || return
    echo "handoff: written ($(wc -l < "$path") lines)"
}

run_usage() {
    cat <<'EOF'
Usage: tools/decomp campaigns run [--count N] [--mode auto|refinement|coverage]
         [--address ADDR] [--batch N] [--budget N] [--harness auto|claude|codex]
         [--effort LEVEL] [--model M] [--writer CMD] [--writer-format FORMAT]
         [--trailer TEXT] [--no-cleanup] [--push] [--json]
       tools/decomp campaigns run --check [--live] | --dry-run [--count N] | --status [--json]
After the last batch of a campaign that raised the score, one CLEANUP writer run (two bc
runs, effort medium unless --effort) names constants and adds comments on the best tree;
a tie keeps its edits, and a finish that fails with them finishes the batch model instead.
--no-cleanup skips it.
--check prints one line per check; --live adds one minimal writer call. --dry-run
prints the next N campaigns and starts nothing. --status reads
build/decomp-runs/state.json from any shell. --json prints the JSON events of
build/decomp-runs/events.jsonl instead of text lines.
--harness defaults to DECOMP_HARNESS, else auto: the Claude Code or Codex session
the command runs in, else the first of claude, codex on PATH. --effort defaults:
claude xhigh, codex high. --writer CMD (or DECOMP_WRITER) replaces the built-in
command; --writer-format claude-json|codex-jsonl|text says how to read its output.
Exit: 0 done; 1 stopped for review (finish failed twice, stop rule, tool error);
2 usage or check failure; 3 writer or harness failure (missing binary, auth,
network, quota, timeout, no attempt logged); 130 interrupted.
A run takes minutes per campaign: start it in the background (docs/decomp-agent.md)
and watch --status. Stop it with kill -TERM PID: a background run ignores Ctrl-C,
and kill -9 leaves the writer running.
EOF
}

# Print one operator line and append it to build/decomp-runs/events.jsonl as a
# JSON event (--json prints the event instead of the line). During a run, --set
# fields also go into state.json, which --status reads from another shell. A
# failed logger never hides the line.
run_emit() {
    python tools/decomp_attempts.py event "$@" ${run_json:+--json} ${run_owns_state:+--state} \
        || printf '%s\n' "$2"
}

# Record a phase change as an event (throughput --runs times the phases from it)
# and other run fields in state.json; prints nothing.
run_phase() {
    local pairs=() pair
    run_phase_name=$1
    [[ -n $run_owns_state ]] || return 0
    pairs=(--set "phase=$1")
    shift
    for pair in "$@"; do pairs+=(--set "$pair"); done
    python tools/decomp_attempts.py event phase "phase $run_phase_name" \
        --field "phase=$run_phase_name" "${pairs[@]}" --state --quiet || true
}

# Print the error line of a stopped run (it names the log and one next step) and
# keep both for the final line. Return the exit status the run ends with.
run_error() {
    run_reason=$2 run_next=$3
    run_emit error "error: $2; next: $3" --stderr --field "exit=$1"
    return "$1"
}

# Print the final line "run: exit N (REASON); next: COMMAND" and return N.
run_final() {
    local code=0
    run_final_done=1
    python tools/decomp_attempts.py final --kind "$1" --reason "$2" --next "$3" \
        ${run_json:+--json} ${run_owns_state:+--state} || code=$?
    return "$code"
}

# An unexpected exit (a shell error under set -eu) stops the writer, settles the
# campaign and still ends with a final line and state, so a supervisor never waits
# on a run that is gone. The process exits 1, the code the final line names.
run_on_exit() {
    [[ -z ${run_final_done:-} ]] || return 0
    run_reason="the driver stopped on a shell error (status $1); see the line above"
    run_next="tools/decomp campaigns run --status"
    run_settle
    run_final review "$run_reason" "$run_next" || true
    exit 1
}

# Resolve the harness and the writer command. tools/decomp_attempts.py writer is
# the one place that defines the built-in commands.
run_resolve() {
    local lines=() from=$harness_from
    [[ -z $writer_override ]] || from=$writer_from
    mapfile -t lines < <(python tools/decomp_attempts.py --root "$ROOT" writer \
        --harness "$harness_choice" --from="$from" --writer="$writer_override" \
        --format="$writer_format" --effort="$effort" --model="$model")
    harness=${lines[0]:-} harness_reason=${lines[1]:-} writer_format=${lines[2]:-text}
    writer_binary=${lines[3]:-} writer=${lines[4]:-}
    case $writer_format in
        claude-json|codex-jsonl) suffix=.jsonl ;;
        *) suffix=.txt ;;
    esac
}

# One check line, "check: NAME ok|FAIL detail; fix: HINT". A run prints only the
# failures; the first failure gives the reason and next step of the final line.
run_check_line() {
    local text="check: $1 $2 $3"
    if [[ $2 == FAIL ]]; then
        text+="${4:+; fix: $4}"
        check_failed=$((check_failed + 1))
        if [[ -z $check_reason ]]; then
            check_reason="$1: $3" check_next=${5:-tools/decomp campaigns run --check}
        fi
    elif [[ -n $check_quiet ]]; then
        return 0
    fi
    run_emit check "$text" --field "name=$1" --field "status=$2"
}

# The setup checks of --check and of the start of every run. check_harness is set
# when no writer can start at all: a run then exits 3, not 2.
run_checks() {
    local version dirty missing="" item other=claude busy="" busy_next="" summary code=0
    [[ $harness != claude ]] || other=codex
    if [[ -n $harness ]]; then
        run_check_line harness ok "$harness ($harness_reason)"
    else
        check_harness=1
        run_check_line harness FAIL "$harness_reason" "install claude or codex, or pass --writer CMD" \
            "command -v claude codex"
    fi
    if [[ -n $writer_binary ]] && command -v "$writer_binary" > /dev/null; then
        version=""
        if [[ $writer_binary == claude || $writer_binary == codex ]]; then
            version=" $("$writer_binary" --version 2> /dev/null | head -n 1 || true)"
        fi
        run_check_line binary ok "$writer_binary$version ($(command -v "$writer_binary"))"
        run_check_line writer ok "$writer_format: $writer"
    elif [[ -n $harness ]]; then
        check_harness=1
        run_check_line binary FAIL "${writer_binary:-the writer} is not on PATH" \
            "install it or pass --harness $other" "tools/decomp campaigns run --check --harness $other"
    fi
    if [[ -n ${CODEX_SANDBOX_NETWORK_DISABLED:-} ]]; then
        check_harness=1
        run_check_line network FAIL "this Codex sandbox blocks network, so no writer reaches its API" \
            "set sandbox_workspace_write.network_access = true in ~/.codex/config.toml or run outside the sandbox" \
            "tools/decomp campaigns run --check --live"
    elif [[ $harness == codex ]]; then
        run_check_line network ok "no Codex sandbox blocks the network"
    else
        run_check_line network skip "tested only by --live"
    fi
    if ! dirty=$(git status --porcelain -- src tools/Resources/functions_map.txt 2> /dev/null); then
        run_check_line tree FAIL "$ROOT is not a git work tree" "run from a repository checkout" \
            "git rev-parse --show-toplevel"
    elif [[ -n $dirty ]]; then
        run_check_line tree FAIL "$(wc -l <<< "$dirty") uncommitted changes under src or the function map" \
            "commit or restore them" "git status --short -- src tools/Resources/functions_map.txt"
    else
        run_check_line tree ok "src and the function map match HEAD"
    fi
    for item in build/toy2.exe build/decomp-function-sizes.json; do
        [[ -s $item ]] || missing+=" $item"
    done
    if [[ -n $missing ]]; then
        run_check_line build FAIL "missing:$missing" "build it" "tools/decomp baseline"
    else
        run_check_line build ok "build/toy2.exe and build/decomp-function-sizes.json are present"
    fi
    if [[ -z $check_quiet ]]; then
        run_select 1 reuse || code=$?
        if ((code == 0)); then
            run_check_line candidates ok \
                "next: $run_address $run_name ($run_mode, subsystem $run_subsystem)"
        elif ((code == 4)); then
            run_check_line candidates FAIL "$select_error" "no work is left in the queue" \
                "tools/decomp candidates --refine --yield --why"
        else
            run_check_line candidates FAIL "$select_error" "read the log" \
                "tail -n 20 ${select_files}candidates.log"
        fi
        tried=()
    fi
    IFS=$'\t' read -r busy busy_next < <(python tools/decomp_attempts.py run-status --busy \
        --self "$$" 2> /dev/null) || true
    if [[ -n $busy ]]; then
        run_check_line state FAIL "$busy" "let it end, or stop it with kill -TERM" "$busy_next"
    elif [[ -f $campaign_state_file ]]; then
        summary=$(python -c 'import json, sys; s = json.load(open(sys.argv[1]))
print(", ".join(s.get("addresses") or []) or "-", "phase", s.get("phase", "started"))' \
            "$campaign_state_file" 2> /dev/null || echo "$campaign_state_file")
        run_check_line state FAIL "a campaign is active ($summary)" \
            "finish it, or tools/decomp campaigns abort --reason TEXT" "tools/decomp campaigns status"
    else
        run_check_line state ok "no active campaign or run"
    fi
    if mkdir -p "$runs" 2> /dev/null && touch "$runs/.write-check" 2> /dev/null; then
        rm -f "$runs/.write-check"
        run_check_line logs ok "$runs is writable"
    else
        run_check_line logs FAIL "$runs is not writable" "check the permissions of build/" \
            "ls -ld build $runs"
    fi
}

# --check --live: one minimal writer call through the real writer command. It
# shows turns, context size, denials and the exact error of a failed call.
run_check_live() {
    local out="$runs/check-live$suffix" prompt="$runs/check-live.prompt" status=0 head
    local started=$SECONDS verdict="" detail="" fix="" next=""
    head=$(git log -1 --format=%h 2> /dev/null || true)
    printf '%s\n' "This is a setup check, not a batch: edit nothing and run no build." \
        "Run exactly one shell command, git log --oneline -1, then reply with two lines:" \
        "its output, and the first line of your instructions that starts with \"# \"." \
        > "$prompt"
    DECOMP_WRITER_TIMEOUT=${DECOMP_WRITER_TIMEOUT:-300} run_writer "$prompt" "$out" || status=$?
    IFS=$'\t' read -r verdict detail fix next < <(python tools/decomp_attempts.py \
        writer-usage "$out" --format "$writer_format" --harness "$harness" --live "$head" \
        --status "$status" --seconds "$((SECONDS - started))") || true
    [[ -n $next ]] || next="tail -n 20 $out"
    run_usage_file
    printf '%s\t%s\t-\tcheck\tnone\t-\t%s\t%s\n' "$(date -u +%FT%TZ)" "$harness" \
        "$((SECONDS - started))" "$(python tools/decomp_attempts.py writer-usage "$out" \
        --format "$writer_format")" >> "$runs/usage.tsv"
    run_check_line live "${verdict:-FAIL}" "${detail:-no verdict} (log: $out)" "$fix" "$next"
}

# usage.tsv holds one row per writer run. A file with another header is kept
# under a timestamped name, so every row of usage.tsv has the same columns.
run_usage_file() {
    local header=$'time\tharness\taddress\tbatch\tattempts\tbest\tseconds\tcost_usd\tinput'
    header+=$'\tcache_write\tcache_read\toutput\treasoning\tturns\tapi_ms\tdenials\terror'
    if [[ -s $runs/usage.tsv && $(head -n 1 "$runs/usage.tsv") != "$header" ]]; then
        mv -f "$runs/usage.tsv" "$runs/usage-$(date -u +%Y%m%dT%H%M%SZ).tsv"
    fi
    [[ -s $runs/usage.tsv ]] || printf '%s\n' "$header" > "$runs/usage.tsv"
}

# Run the writer on one assignment. It runs in the background under wait, so
# the INT/TERM trap of campaign_run can stop it: timeout moves the writer into
# its own process group, which a Ctrl-C or a kill of the driver's group never
# reaches. The session variables are dropped, so a driver started inside a
# Claude Code or Codex session does not make the writer part of that session.
# With WATCH set, one line per logged attempt prints while the writer works.
# writer_refs names a change of git refs: the driver, not the writer, commits.
run_writer() {
    local status=0 last="${2%.*}.last.txt" refs
    rm -f "$2" "$last"
    refs=$(run_refs)
    # Writers never push: every push URL is rewritten to a scheme git cannot
    # reach. The codex sandbox needs network for the Wine server socket and
    # AGENTS.md says to push, so the skill text alone does not stop a push.
    DECOMP_WRITER_LAST="$ROOT/$last" GIT_CONFIG_COUNT=3 \
        GIT_CONFIG_KEY_0="url.writer-push-disabled://.pushInsteadOf" GIT_CONFIG_VALUE_0="https://" \
        GIT_CONFIG_KEY_1="url.writer-push-disabled://.pushInsteadOf" GIT_CONFIG_VALUE_1="ssh://" \
        GIT_CONFIG_KEY_2="url.writer-push-disabled://.pushInsteadOf" GIT_CONFIG_VALUE_2="git@" \
        env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT \
        -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_MESSAGING_SOCKET \
        -u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_PID -u CLAUDE_EFFORT -u CODEX_THREAD_ID \
        -u CODEX_SESSION_ID -u CODEX_CI \
        timeout --kill-after=60 "${DECOMP_WRITER_TIMEOUT:-2400}" bash -c "$writer" \
        < "$1" > "$2" 2> "${2%.*}.stderr" &
    writer_pid=$!
    [[ -z $run_owns_state ]] || python tools/decomp_attempts.py event state --state \
        --set "writer_pid=$writer_pid" || true
    [[ -z ${3:-} ]] || run_watch
    wait "$writer_pid" || status=$?
    writer_pid=""
    if [[ -n $watch_pid ]]; then
        wait "$watch_pid" 2> /dev/null || true
        watch_pid=""
    fi
    [[ -z $run_owns_state ]] || python tools/decomp_attempts.py event state --state \
        --set "writer_pid=" || true
    writer_refs=""
    [[ $(run_refs) == "$refs" ]] \
        || writer_refs="the writer changed git refs (HEAD ${refs%% *} -> $(git rev-parse --short HEAD))"
    return "$status"
}

# HEAD and a checksum of every branch, remote and tag ref: a commit, reset, branch
# switch or push changes them.
# Only what a writer's commit, reset or checkout would move: this checkout's HEAD, the
# branch it is on and that branch's commit. Other worktrees share the ref store and create
# or move their own branches at any time, which is not the writer's doing.
run_refs() {
    local branch
    branch=$(git symbolic-ref -q HEAD 2> /dev/null || true)
    printf '%s %s %s\n' "$(git rev-parse --short HEAD 2> /dev/null || true)" "${branch:-detached}" \
        "$( [[ -n $branch ]] && git rev-parse -q --verify "$branch" 2> /dev/null || true)"
}

# Stop a campaign whose writer moved git refs, because the driver owns commits and
# pushes; src is kept for review.
run_guard_refs() {
    [[ -n $writer_refs ]] || return 0
    "$self" campaigns abort --reason "campaigns run: $writer_refs." > "$prefix-abort.log" 2>&1 || true
    run_active=""
    run_error 3 "$writer_refs; the driver owns commits, so campaign $run_address is aborted and src kept (log: $1)" \
        "git reflog -5"
}

# Print "  attempt K: raw X% (best Y%)" for each attempt the writer logs. tail -F
# waits on the attempt file and stops by itself when the writer process ends.
run_watch() {
    local file="build/decomp-attempts/$run_address.jsonl" best=$run_best line n raw
    touch "$file"
    tail -n "+$((run_attempts + 1))" -F --pid="$writer_pid" "$file" 2> /dev/null \
        | while IFS= read -r line; do
            [[ $line =~ \"n\":\ ([0-9]+) ]] || continue
            n=${BASH_REMATCH[1]}
            [[ $line =~ \"raw\":\ ([0-9.]+) ]] || continue
            raw=$(run_math 'printf "%.2f", a' "${BASH_REMATCH[1]}")
            best=$(run_math 'printf "%.2f", (a > b ? a : b)' "$raw" "$best")
            run_emit attempt "  attempt $n: raw $raw% (best $best%)" --field "attempt=$n" \
                --field "raw=$raw" --field "best=$best" --set "attempts=$n" --set "best=$best"
        done &
    watch_pid=$!
}

# A stop signal during a run: stop the writer, settle the campaign and exit 130, so
# no writer keeps editing src after the driver is gone. bash runs the handler once
# a foreground step (bc, finish) returns, so run_settle reports what it committed.
run_interrupt() {
    trap - INT TERM HUP QUIT
    run_reason="interrupted by SIG$1 in phase ${run_phase_name:-start}"
    run_next="tools/decomp campaigns run --check"
    run_settle
    run_final interrupted "$run_reason" "$run_next" || true
    exit 130
}

run_trap_signals() {
    local signal
    for signal in INT TERM HUP QUIT; do trap "run_interrupt $signal" "$signal"; done
}

# Hold stop signals until a step that must not stop half way ends; the caller then
# acts on run_held.
run_hold_signals() {
    local signal
    for signal in INT TERM HUP QUIT; do trap "run_held=$signal" "$signal"; done
}

# Stop the writer and its attempt watcher. timeout passes the TERM on to the
# writer's process group, which a signal to the driver's group never reaches.
run_stop_writer() {
    if [[ -n ${writer_pid:-} ]]; then
        kill -TERM "$writer_pid" 2> /dev/null || true
        wait "$writer_pid" 2> /dev/null || true
        writer_pid=""
    fi
    [[ -z ${watch_pid:-} ]] || kill "$watch_pid" 2> /dev/null || true
    watch_pid=""
}

# Settle a run that stops early: stop the writer, abort the campaign this run
# started and did not end, and add to run_reason what is left (the commits of the
# run, changed src, the best patch). run_next becomes the one command to run next.
run_settle() {
    local made=0 changed=0 log
    run_stop_writer
    if [[ -n ${run_active:-} && -f $campaign_state_file ]] &&
        grep -q "\"$run_active\"" "$campaign_state_file" 2> /dev/null; then
        log="$runs/$run_active-abort.log"
        if "$self" campaigns abort --reason "campaigns run stopped early." > "$log" 2>&1; then
            run_reason+="; campaign $run_active aborted"
        else
            run_reason+="; campaign $run_active is still active (log: $log)"
            run_next="tools/decomp campaigns status"
            return 0
        fi
    fi
    [[ -z ${run_head:-} ]] || made=$(git rev-list --count "$run_head..HEAD" 2> /dev/null || echo 0)
    changed=$(git status --porcelain -- src tools/Resources/functions_map.txt 2> /dev/null | wc -l || true)
    if ((made > 0)); then
        run_reason+="; the run made $made commits, last $(git rev-parse --short HEAD)"
        run_next="git push origin $(git branch --show-current)"
    fi
    if ((changed > 0)); then
        run_reason+="; src has $changed changed paths"
        [[ -z ${run_active:-} || ! -s build/decomp-cache/best/$run_active.patch ]] \
            || run_reason+=", best model in build/decomp-cache/best/$run_active.patch"
        run_next="git status --short -- src tools/Resources/functions_map.txt"
    fi
}

# Read the attempt log of the current target into run_attempts, run_best,
# run_best_at, run_last, run_stalled, run_limit and run_cleanups (no scored
# attempt reads 0). run_limit is the budget bc prints, so the driver and the
# writer agree on it; run_cleanups counts the cleanup attempts in run_attempts.
run_read_stats() {
    local fields
    fields=$(python tools/decomp_attempts.py stats --address "$run_address" --json | python -c '
import json, sys
s = json.load(sys.stdin)
print(s["attempts"], "%.2f" % (s["best_raw"] or 0), s["best_attempt"] or 0,
      "%.2f" % (s["last_raw"] or 0), int(s["stalled"]), s["limit"], s["cleanup_attempts"])') || return
    read -r run_attempts run_best run_best_at run_last run_stalled run_limit run_cleanups <<< "$fields"
}

run_math() { awk -v a="$2" -v b="${3:-0}" "BEGIN { $1 }"; }

# Name the spend of a writer run: dollars when the harness reports them (claude),
# else thousands of tokens (codex reports no cost).
run_spend() {
    if [[ $writer_format == claude-json ]]; then
        run_math 'printf "$%.2f", a' "$1"
    else
        run_math 'printf "%.0fk tokens", a / 1000' "$2"
    fi
}

# Append one usage.tsv row and print the batch verdict line.
run_account() {
    local label=$1 out=$2 first=$3 seconds=$4 previous_best=$5 fields range batch_cost
    local batch_tokens denials denied="permission denials" note=""
    range="$first-$run_attempts"
    ((run_attempts >= first)) || range="none"
    fields=$(python tools/decomp_attempts.py writer-usage "$out" --format "$writer_format")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$harness" "$run_address" \
        "$label" "$range" "$run_best" "$seconds" "$fields" >> "$runs/usage.tsv"
    batch_cost=$(cut -f1 <<< "$fields")
    batch_tokens=$(awk -F'\t' '{ print $2 + $3 + $4 + $5 }' <<< "$fields")
    denials=$(cut -f9 <<< "$fields")
    cost=$(run_math 'printf "%.4f", a + b' "$cost" "${batch_cost:-0}")
    tokens=$((tokens + batch_tokens))
    [[ $writer_format != codex-jsonl ]] || denied="sandbox errors"
    ((${denials:-0} == 0)) || note+=", $denials $denied"
    ((writer_status == 0)) || note+=", writer exit $writer_status"
    run_emit batch "$label: attempts $range, best $run_best% ($(run_math 'printf "%+.2f", a - b' \
        "$run_best" "$previous_best")), $(run_math 'printf "%.1f", a / 60' "$seconds") min,\
 $(run_spend "${batch_cost:-0}" "$batch_tokens")$note" --field "label=$label" \
        --field "attempts=$range" --field "best=$run_best" --field "seconds=$seconds" \
        --set "best=$run_best" --set "attempts=$run_attempts"
}

# The batch assignment ends with the orientation pack, so the writer spends no
# turn on fetching it.
run_batch_prompt() {
    local first=$1 last=$2 stub
    echo "BATCH $batch for target $run_address $run_name ($run_mode)."
    echo "Source file: ${run_source:+src/}${run_source:-none yet}; retail size $run_size bytes."
    echo "Attempts logged: $run_attempts; best $run_best% at attempt $run_best_at" \
        "(baseline $baseline%)."
    echo "This batch may run attempts $first-$last; stop earlier when bc prints a \"stall:\" line."
    if [[ $run_mode == coverage ]]; then
        stub=$(grep -rn -- "// STUB: TOY2 $run_address\b" src | head -n 1 | cut -d: -f1,2 || true)
        if [[ -n $stub ]]; then
            echo "Placement: $stub holds \"// STUB: TOY2 $run_address\". Replace the empty" \
                "definition under it with the complete body and change that line to" \
                "\"// FUNCTION: TOY2 $run_address\"."
        else
            echo "Placement: no annotation exists. Add \"// FUNCTION: TOY2 $run_address\" and the" \
                "complete body to the translation unit that holds the map neighbours shown by" \
                "the evidence."
        fi
    fi
    echo "End: your final message is the handoff, with no tool call after it; the driver saves it."
    echo "The orientation pack (tools/decomp bc $run_address --pack) follows; do not run it again."
    "$self" bc "$run_address" --pack 2> /dev/null \
        || echo "(the pack failed; run tools/decomp bc $run_address --pack)"
}

# "N attempts", with the cleanup attempts apart: they name and explain, never match.
run_attempt_count() {
    printf '%s attempts' "$((run_attempts - run_cleanups))"
    ((run_cleanups == 0)) || printf ' (cleanup %s)' "$run_cleanups"
}

# Write the commit message of a source result from the current best score, with
# the handoff's TRIED and OPEN lines and the cleanup summary as its rationale.
run_message() {
    local subject="Refine $run_name to $1%" rationale
    [[ $run_mode == coverage ]] && subject="Implement $run_name at $1%"
    rationale=$(python tools/decomp_attempts.py rationale \
        "build/decomp-cache/handoff/$run_address.md" --cleanup "$prefix-cleanup.summary" || true)
    {
        echo "$subject"
        echo
        echo "$baseline% -> $1% in $(run_attempt_count) across $writer_runs writer runs" \
            "(tools/decomp campaigns run, $harness writer)."
        [[ -z $rationale ]] || printf '\n%s\n' "$rationale"
        [[ -z $trailer ]] || printf '\n%s\n' "$trailer"
    } > "$prefix.msg"
}

# The CLEANUP assignment ends with its work list (literals, block openers, lint
# findings a .cpp edit can fix), so the writer spends no turn on finding it.
run_cleanup_prompt() {
    local file
    file=$(grep -rlE -- "// (FUNCTION|STUB): TOY2 $run_address\b" src | head -n 1 || true)
    echo "CLEANUP for target $run_address $run_name ($run_mode). The tree holds the best model:" \
        "$run_best% at attempt $run_best_at (baseline $baseline%)."
    [[ -z $file ]] || python tools/decomp_attempts.py cleanup-todo "$file" --address "$run_address" \
        2> /dev/null || true
    echo "Follow the Cleanup section of your instructions (two bc runs at most) and end with 1-5" \
        "plain lines under 100 characters saying what changed, with no tool call after them."
}

# One CLEANUP writer run on the best tree, at effort medium unless --effort names
# one: names and comments need no search. Its attempts carry DECOMP_PHASE=cleanup,
# so they spend no budget and a tie becomes the best, which the restore before
# finish keeps; a drop leaves the earlier best.
run_cleanup() {
    local out before_attempts=$run_attempts before_best=$run_best started=$SECONDS
    local patch="build/decomp-cache/best/$run_address.patch" kept="no change kept"
    local writer=$writer harness=$harness harness_choice=$harness writer_format=$writer_format
    local harness_reason="" writer_binary="" suffix=$suffix effort=${effort:-medium}
    [[ -n $writer_override ]] || run_resolve
    if [[ -z $writer ]]; then
        run_emit cleanup "cleanup: skipped ($harness_reason)"
        return 0
    fi
    out="$prefix-cleanup$suffix" cleanup_before=$run_best
    if ! git checkout -q -- src tools/Resources/functions_map.txt ||
        { [[ -s $patch ]] && ! git apply "$patch"; }; then
        run_error 1 "the best patch of $run_address does not apply before the cleanup" \
            "git apply --check $patch"
        return
    fi
    cp -f "$patch" "$prefix-cleanup-before.patch" 2> /dev/null || : > "$prefix-cleanup-before.patch"
    run_cleanup_prompt > "$prefix-cleanup.prompt"
    writer_status=0 writer_runs=$((writer_runs + 1))
    run_phase cleanup "log=$out"
    DECOMP_PHASE=cleanup run_writer "$prefix-cleanup.prompt" "$out" watch || writer_status=$?
    run_read_stats || { run_error 1 "the attempt log of $run_address is unreadable" \
        "python tools/decomp_attempts.py stats --address $run_address"; return; }
    run_account cleanup "$out" "$((before_attempts + 1))" "$((SECONDS - started))" "$before_best"
    run_guard_refs "$out" || return
    if ! cmp -s "$patch" "$prefix-cleanup-before.patch"; then
        cleanup_kept=1
        kept="kept at $run_best% ($(git diff --no-index --numstat "$prefix-cleanup-before.patch" \
            "$patch" 2> /dev/null | awk '{ print $1 + $2 }') patch lines changed)"
        python tools/decomp_attempts.py writer-usage "$out" --format "$writer_format" --result 5 \
            > "$prefix-cleanup.summary" || true
    fi
    run_emit cleanup "cleanup: $kept" --field "kept=$([[ $kept == kept* ]] && echo 1 || echo 0)"
}

# Put back the model the batches left after a finish failed with the cleanup's
# edits, so the cleanup can cost only its own edits; the caller finishes again.
run_drop_cleanup() {
    cleanup_kept=""
    run_emit finish "finish: failed with the cleanup edits; finishing the batch model" \
        --field "log=$finish_log"
    if ! git checkout -q HEAD -- src tools/Resources/functions_map.txt .notes/lint-baseline.tsv ||
        { [[ -s $prefix-cleanup-before.patch ]] && ! git apply "$prefix-cleanup-before.patch"; }; then
        run_error 1 "the pre-cleanup patch of $run_address does not apply" \
            "git apply --check $prefix-cleanup-before.patch"
        return
    fi
    cp -f "$prefix-cleanup-before.patch" "build/decomp-cache/best/$run_address.patch"
    # The ledger's best attempt must name the committed model, not a dropped cleanup tie.
    sed -i '/"phase": "cleanup"/d' "build/decomp-attempts/$run_address.jsonl" || true
    rm -f "$prefix-cleanup.summary"
    final=$cleanup_before
    run_message "$final"
}

run_finish() {
    local note="campaigns run: $baseline% -> $1% in $(run_attempt_count)"
    note+=", $writer_runs $harness writer runs; stopped: $stop"
    finish_log="$prefix-finish$2.log"
    rm -f build/decomp-diffs/validate.log
    run_phase finish "log=$finish_log"
    DECOMP_RUN_EVENTS=1 "$self" campaigns finish --mode "$run_mode" --target "$run_address" --note "$note" \
        --message "$prefix.msg" > "$finish_log" 2>&1
}

# Choose the target of campaign INDEX: run_address, run_name, run_state, run_size,
# run_source, run_subsystem and run_mode. With REUSE (--check, --dry-run) each
# queue is ranked once; a run ranks again for every campaign, after the last commit.
# Return 1 when candidates fails and 4 when no target is eligible.
run_select() {
    local index=$1 reuse=${2:-} row fields=() pick=() list queue=()
    run_mode=$mode select_error=""
    if [[ -n $address ]]; then
        # The source state of the target names its one queue: a FUNCTION is refinement,
        # a STUB or an unstarted function coverage. pick falls back to the map.
        queue=(--refine) list="${select_files}candidates.json"
        if [[ $mode == coverage ]] || { [[ $mode != refinement ]] && ! grep -rqiE --include='*.cpp' \
            "// FUNCTION: TOY2 $(printf '0x%08X' "$address" 2> /dev/null)\b" src; }; then
            queue=(--coverage) list="${select_files}coverage.json"
        fi
        if ! "$self" candidates "${queue[@]}" --json --limit 0 > "$list" \
            2> "${select_files}candidates.log"; then
            select_error="candidates failed (log: ${select_files}candidates.log)"
            return 1
        fi
        pick=("$list" --address "$address")
    else
        if [[ $run_mode == auto ]]; then
            run_mode=refinement
            ((index % 3 != 0)) || run_mode=coverage
        fi
        queue=(--refine --yield) list="${select_files}candidates.json"
        if [[ $run_mode == coverage ]]; then
            queue=(--coverage) list="${select_files}coverage.json"
        fi
        if [[ -z $reuse || $ranked != *" $run_mode "* ]]; then
            if ! "$self" candidates "${queue[@]}" --json --limit 25 > "$list" \
                2> "${select_files}candidates.log"; then
                select_error="candidates failed (log: ${select_files}candidates.log)"
                return 1
            fi
            ranked+=" $run_mode "
        fi
        pick=("$list")
        [[ $run_mode != coverage ]] || pick+=(--coverage)
        for row in "${tried[@]}"; do pick+=(--skip "$row"); done
    fi
    if ! row=$(python tools/decomp_attempts.py pick "${pick[@]}"); then
        select_error="no eligible ${address:-$run_mode} target"
        return 4
    fi
    mapfile -t fields <<< "$row"
    run_address=${fields[0]} run_name=${fields[1]} run_state=${fields[2]}
    run_size=${fields[3]} run_source=${fields[4]} run_subsystem=${fields[5]}
    if [[ $run_mode == auto ]]; then
        run_mode=refinement
        [[ $run_state != STUB && $run_state != NOT_STARTED ]] || run_mode=coverage
    fi
    tried+=("$run_address")
}

# Record a no-source campaign with the models its writers tried, so no writer
# retests them, and commit the record.
run_record() {
    local models=() model_args=() model
    mapfile -t models < <(python tools/decomp_attempts.py tried \
        "build/decomp-cache/handoff/$run_address.md")
    ((${#models[@]} > 0)) || models=("no writer model scored above the $baseline% baseline")
    for model in "${models[@]}"; do model_args+=(--model "$model"); done
    if ! "$self" campaigns record --result no-source --note "no attempt raised the score" \
        "${model_args[@]}" > "$prefix-record.log" 2>&1; then
        run_error 1 "the no-source record failed (log: $prefix-record.log)" \
            "tail -n 20 $prefix-record.log"
        return
    fi
    {
        echo "Record no-source campaign on $run_name"
        [[ -z $trailer ]] || printf '\n%s\n' "$trailer"
    } > "$prefix.msg"
    if ! { git add tools/Resources/campaign-ledger.jsonl tools/Resources/scoreboard.tsv \
        .notes/source-models.md && git commit -q -F "$prefix.msg"; }; then
        run_error 1 "the no-source commit failed" "git status --short"
        return
    fi
}

# One campaign: select, start, writer batches, then a validated commit or a
# no-source record. Set run_result and run_family for the stop rule. Return 0 on
# a result, 1 on a fatal error, 3 on a writer failure and 4 when no target is left;
# run_error keeps the reason and next step of every stop for the final line.
run_campaign() {
    local index=$1 started=$SECONDS cost=0 tokens=0 writer_runs=0 stop="" batch=0 broken=""
    local broken_fix="" broken_next="" failure=() said line code
    local run_mode=$mode run_address run_name run_state run_size run_source run_subsystem
    local run_attempts run_best run_best_at run_last run_stalled run_limit run_cleanups writer_status=0
    local cleanup_kept="" cleanup_before=0
    local baseline baseline_attempts prefix final bytes="+0.00" sha="-" finish_log json
    if [[ -n $(git status --porcelain -- src tools/Resources/functions_map.txt) ]]; then
        run_error 1 "src or the function map has uncommitted changes before campaign $index" \
            "git status --short -- src tools/Resources/functions_map.txt"
        return
    fi
    run_phase select "campaign=$index" "target=" "name=" "baseline=" "batch=0"
    run_select "$index" || {
        code=$?
        if ((code == 4)); then
            run_reason="$select_error after $done_count campaigns"
            run_next="tools/decomp candidates --refine --yield --why"
            run_emit stop "campaign $index: $select_error; run stopped"
            return 4
        fi
        run_error 1 "$select_error" "tail -n 20 ${select_files}candidates.log"
        return
    }
    run_family=$run_subsystem
    prefix="$runs/$run_address"
    rm -f "$prefix"-* "$prefix.msg"
    # A handoff left by an interrupted run numbers attempts of another baseline.
    rm -f "build/decomp-cache/handoff/$run_address.md"
    run_phase start "target=$run_address" "name=$run_name" "mode=$run_mode" \
        "subsystem=$run_subsystem" "log=$prefix-start.log"
    # Set before the start, so a signal held back until the start returns aborts it.
    run_active=$run_address
    if ! "$self" campaigns start --mode "$run_mode" --address "$run_address" \
        --subsystem "$run_subsystem" > "$prefix-start.log" 2>&1; then
        run_active=""
        run_error 1 "campaigns start failed for $run_address (log: $prefix-start.log)" \
            "tail -n 20 $prefix-start.log"
        return
    fi
    run_phase baseline "log=$prefix-bc.log"
    if ! "$self" bc "$run_address" > "$prefix-bc.log" 2>&1; then
        run_active=""
        "$self" campaigns abort --reason "The baseline bc failed." > /dev/null 2>&1
        run_error 1 "the baseline bc of $run_address failed (log: $prefix-bc.log)" \
            "tail -n 30 $prefix-bc.log"
        return
    fi
    run_read_stats || { run_error 1 "the attempt log of $run_address is unreadable" \
        "python tools/decomp_attempts.py stats --address $run_address"; return; }
    baseline=$run_best baseline_attempts=$run_attempts
    run_emit campaign "campaign $index: $run_address $run_name $run_mode, baseline $baseline%" \
        --field "campaign=$index" --field "address=$run_address" --field "mode=$run_mode" \
        --field "baseline=$baseline" --set "baseline=$baseline" --set "best=$run_best" \
        --set "attempts=$run_attempts"
    local first last before_attempts before_best batch_started
    while true; do
        if ((run_stalled)); then stop="stalled"; break; fi
        if ((run_attempts >= run_limit)); then stop="budget"; break; fi
        batch=$((batch + 1)) writer_runs=$((writer_runs + 1))
        first=$((run_attempts + 1)) last=$((run_attempts + batch_size))
        ((last > run_limit)) && last=$run_limit
        before_attempts=$run_attempts before_best=$run_best batch_started=$SECONDS
        json="$prefix-batch$batch$suffix"
        run_phase batch "batch=$batch" "log=$json"
        run_batch_prompt "$first" "$last" > "$prefix-batch$batch.prompt"
        writer_status=0
        run_writer "$prefix-batch$batch.prompt" "$json" watch || writer_status=$?
        run_read_stats || { run_error 1 "the attempt log of $run_address is unreadable" \
            "python tools/decomp_attempts.py stats --address $run_address"; return; }
        run_account "batch $batch" "$json" "$first" "$((SECONDS - batch_started))" "$before_best"
        run_guard_refs "$json" || return
        python tools/decomp_attempts.py writer-usage "$json" --format "$writer_format" --handoff \
            | handoff "$run_address" > /dev/null 2>&1 || true
        if ((run_attempts == before_attempts)); then
            mapfile -t failure < <(python tools/decomp_attempts.py writer-usage "$json" \
                --format "$writer_format" --harness "$harness" --failure "$writer_status")
            broken=${failure[0]:-} broken_fix=${failure[1]:-} broken_next=${failure[2]:-}
            run_emit batch "batch $batch: no new attempt${broken:+ ($broken)}; the writer said:"
            said=$(python tools/decomp_attempts.py writer-usage "$json" --format "$writer_format" \
                --result 3)
            while IFS= read -r line; do
                [[ -z $line ]] || run_emit batch "  $line"
            done <<< "$said"
            stop="no new attempt"; break
        fi
        if run_math 'exit !(a - b < 0.5)' "$run_best" "$before_best"; then
            stop="batch gain under 0.5"; break
        fi
    done
    if ((cleanup)) && [[ -z $broken ]] && run_math 'exit !(a > b)' "$run_best" "$baseline"; then
        run_cleanup || return
    fi
    # Restore the best compiled tree: the tree the writer left may hold a worse model.
    git checkout -q -- src tools/Resources/functions_map.txt \
        || { run_error 1 "git checkout of src failed" "git status --short -- src"; return; }
    if [[ -s build/decomp-cache/best/$run_address.patch ]] &&
        ! git apply build/decomp-cache/best/"$run_address".patch; then
        run_error 1 "the best patch of $run_address does not apply; the tree is at HEAD" \
            "git apply --check build/decomp-cache/best/$run_address.patch"
        return
    fi
    final=$run_best
    if run_math 'exit !(a > b)' "$final" "$baseline"; then
        run_message "$final"
        local finished=0
        run_finish "$final" 1 && finished=1
        if ((!finished)) && [[ -n $cleanup_kept ]]; then
            run_drop_cleanup || return
            run_finish "$final" 1b && finished=1
        fi
        if ((!finished)); then
            if [[ -n $broken ]]; then
                run_error 3 "finish failed and $broken, so no repair runs; the tree is left for review (log: $finish_log)" \
                    "tail -n 30 $finish_log"
                return
            fi
            local problems
            problems=$(python tools/decomp_attempts.py failures build/decomp-diffs/validate.log)
            [[ -n $problems ]] || problems=$(grep -E '^error: ' "$finish_log" | tail -n 5)
            run_emit finish "finish: failed; one repair run for: $(head -n 1 <<< "$problems")" \
                --field "log=$finish_log"
            {
                echo "REPAIR target $run_address $run_name ($run_mode). campaigns finish failed with:"
                printf '%s\n' "$problems"
                echo "Fix only these problems in the target's source, run tools/decomp bc" \
                    "$run_address once, and return the REPAIR line."
            } > "$prefix-repair.prompt"
            before_attempts=$run_attempts before_best=$run_best batch_started=$SECONDS
            writer_status=0 writer_runs=$((writer_runs + 1))
            run_phase repair "log=$prefix-repair$suffix"
            run_writer "$prefix-repair.prompt" "$prefix-repair$suffix" watch || writer_status=$?
            run_read_stats || { run_error 1 "the attempt log of $run_address is unreadable" \
                "python tools/decomp_attempts.py stats --address $run_address"; return; }
            run_account "repair" "$prefix-repair$suffix" "$((before_attempts + 1))" \
                "$((SECONDS - batch_started))" "$before_best"
            run_guard_refs "$prefix-repair$suffix" || return
            ((run_attempts > before_attempts)) && final=$run_last
            run_message "$final"
            if ! run_finish "$final" 2; then
                run_error 1 "finish failed twice; the tree is left as is for review (log: $prefix-finish2.log)" \
                    "tail -n 30 $prefix-finish2.log"
                return
            fi
        fi
        sha=$(sed -n 's/^finished: //p' "$finish_log") run_active=""
        bytes=$(grep -oE 'campaign: [-+][0-9.]+ code' "$finish_log" | grep -oE '[-+][0-9.]+')
        bytes=${bytes:-+0.00} run_result=source
        committed=$((committed + 1))
    elif ((run_attempts == baseline_attempts)) || [[ -n $broken ]]; then
        # A writer that did no work says nothing about the target. A no-source
        # row would skip the target later and count toward the stop rule.
        broken=${broken:-the writer logged no attempt}
        "$self" campaigns abort --reason "campaigns run: $broken." > "$prefix-abort.log" 2>&1
        run_active=""
        run_error 3 "campaign $index: $run_address: $broken${broken_fix:+; $broken_fix}; campaign aborted (logs: $prefix-*)" \
            "${broken_next:-tools/decomp campaigns run --check --live --harness $harness}"
        return
    else
        # A stop signal waits until the record is committed, so no record is left
        # without its commit.
        run_phase record "log=$prefix-record.log"
        code=0
        run_hold_signals
        run_record || code=$?
        run_trap_signals
        [[ -z $run_held ]] || run_interrupt "$run_held"
        ((code == 0)) || return "$code"
        sha=$(git rev-parse --short HEAD) run_result=no-source run_active=""
        rm -f "build/decomp-cache/handoff/$run_address.md" "build/decomp-attempts/$run_address.jsonl"
    fi
    ((push == 0)) || run_phase push
    if ((push)) && ! git push -q origin agent/continuous; then
        run_error 1 "git push failed after commit $sha" "git push origin agent/continuous"
        return
    fi
    local minutes
    minutes=$(run_math 'printf "%.1f", a / 60' "$((SECONDS - started))")
    run_emit campaign "campaign $index: $run_address $run_name $run_mode $baseline% -> $final% ($bytes B), $(run_attempt_count), $minutes min, $(run_spend "$cost" "$tokens"), commit $sha" \
        --field "campaign=$index" --field "address=$run_address" --field "result=$run_result" \
        --field "final=$final" --field "bytes=$bytes" --field "commit=$sha" \
        --field "baseline=$baseline" --field "attempts=$run_attempts" --field "minutes=$minutes" \
        --set "best=$final"
    total_cost=$(run_math 'printf "%.4f", a + b' "$total_cost" "$cost")
    total_tokens=$((total_tokens + tokens))
    total_bytes=$(run_math 'printf "%+.2f", a + b' "$total_bytes" "$bytes")
    total_attempts=$((total_attempts + run_attempts - run_cleanups)) done_count=$((done_count + 1))
    if [[ -n $broken ]]; then
        run_error 3 "$broken${broken_fix:+; $broken_fix}; run stopped after campaign $index (log: $json)" \
            "${broken_next:-tools/decomp campaigns run --check --live --harness $harness}"
        return
    fi
    # A transcript keeps every tool result; throughput --runs reads the compressed ones.
    [[ $suffix != .jsonl ]] || gzip -fq -- "$prefix"-batch*.jsonl "$prefix"-repair.jsonl 2> /dev/null || true
}

# --dry-run: the next campaigns as a run would select them; nothing starts.
run_dry_run() {
    local index code planned=0
    if [[ -z $harness ]]; then
        run_final writer "$harness_reason" "tools/decomp campaigns run --check"
        return
    fi
    run_emit harness "harness: $harness ($harness_reason), budget $budget, batch $batch_size" \
        --field "harness=$harness" --field "budget=$budget" --field "batch=$batch_size"
    for ((index = 1; index <= count; index++)); do
        code=0
        run_select "$index" reuse || code=$?
        if ((code == 4)); then
            run_emit dry-run "dry-run $index: $select_error"
            break
        elif ((code != 0)); then
            run_final review "$select_error" "tail -n 20 ${select_files}candidates.log"
            return
        fi
        planned=$((planned + 1))
        run_emit dry-run "dry-run $index: $run_address $run_name $run_mode, subsystem $run_subsystem" \
            --field "campaign=$index" --field "address=$run_address" --field "name=$run_name" \
            --field "mode=$run_mode" --field "subsystem=$run_subsystem"
    done
    run_final done "dry run of $planned campaigns; nothing started; $run_background" \
        "tools/decomp campaigns run --count $count --harness $harness"
}

# campaigns run: the whole loop of AGENTS.md without an orchestrating model. The
# script selects, starts, runs writer batches, restores the best tree and
# finishes or records no-source; logs go to build/decomp-runs/.
campaign_run() {
    local count=1 mode=auto address="" batch_size=4 budget=12 trailer="" push=0 cleanup=1
    local self="$ROOT/tools/decomp" runs=build/decomp-runs tried=() committed=0 total_cost=0
    local total_tokens=0 total_bytes=+0.00 total_attempts=0 run_started=$SECONDS index status=0
    local done_count=0 writer_pid="" watch_pid="" run_active="" run_result="" run_family=""
    local families=() harness_choice=${DECOMP_HARNESS:-auto} harness_from=auto
    local writer_override=${DECOMP_WRITER:-} writer_from=DECOMP_WRITER writer_format=""
    local effort="" model="" action=run live=0 run_json="" run_owns_state="" run_phase_name=""
    local run_reason="" run_next="" harness="" harness_reason="" writer="" writer_binary=""
    local suffix=.json ranked=" " select_error="" check_failed=0 check_harness=0
    local check_quiet="" check_reason="" check_next="" kind problem="" other other_next
    local select_files=$runs/ run_head="" run_held="" writer_refs="" code=0
    local run_background="a run takes minutes per campaign, so start it in the background"
    [[ -z ${DECOMP_HARNESS:-} ]] || harness_from=DECOMP_HARNESS
    # printf and awk must write and read "0.25", whatever the user's locale.
    export LC_NUMERIC=C
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) run_usage; return 0 ;;
            --push) push=1; shift; continue ;;
            --no-cleanup) cleanup=0; shift; continue ;;
            --check|--dry-run|--status) action=${1#--}; shift; continue ;;
            --live) live=1; shift; continue ;;
            --json) run_json=1; shift; continue ;;
        esac
        if [[ $# -lt 2 ]]; then
            run_final usage "run argument $1 needs a value" "tools/decomp campaigns run --help"
            return
        fi
        case "$1" in
            --count) count="$2" ;;
            --mode) mode="$2" ;;
            --address) address="$2" ;;
            --batch) batch_size="$2" ;;
            --budget) budget="$2" ;;
            --harness) harness_choice="$2" harness_from=--harness ;;
            --effort) effort="$2" ;;
            --model) model="$2" ;;
            --writer) writer_override="$2" writer_from=--writer ;;
            --writer-format) writer_format="$2" ;;
            --trailer) trailer="$2" ;;
            *) run_final usage "unknown run argument $1" "tools/decomp campaigns run --help"
               return ;;
        esac
        shift 2
    done
    [[ $count =~ ^[1-9][0-9]*$ && $batch_size =~ ^[1-9][0-9]*$ ]] \
        || problem="--count and --batch need positive whole numbers"
    # The baseline bc is attempt 1, so a budget below 2 leaves the writer nothing.
    [[ $budget =~ ^[0-9]+$ ]] && ((budget >= 2)) \
        || problem="--budget needs a whole number of 2 or more (the baseline bc is attempt 1)"
    [[ $mode =~ ^(auto|refinement|coverage)$ ]] || problem="--mode must be auto, refinement or coverage"
    [[ $harness_choice =~ ^(auto|claude|codex)$ ]] || problem="--harness must be auto, claude or codex"
    [[ -z $writer_format || $writer_format =~ ^(claude-json|codex-jsonl|text)$ ]] \
        || problem="--writer-format must be claude-json, codex-jsonl or text"
    [[ -z $effort || $effort =~ ^[a-z]+$ ]] || problem="--effort needs a level such as high"
    if [[ -n $address && ! $address =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
        problem="--address needs an address such as 0x00401230"
    elif [[ -n $address ]]; then
        address=$(printf '0x%08X' "$address") count=1
    fi
    if ((push)) && [[ $(git branch --show-current 2> /dev/null) != agent/continuous ]]; then
        problem="--push pushes agent/continuous; check out that branch first"
    fi
    if [[ -n $problem ]]; then
        run_final usage "$problem" "tools/decomp campaigns run --help"
        return
    fi
    if [[ $action == status ]]; then
        python tools/decomp_attempts.py run-status ${run_json:+--json}
        return
    fi
    mkdir -p "$runs" 2> /dev/null || true
    run_resolve
    # --check and --dry-run may run beside a live run, so they keep their own queue files.
    [[ $action == run ]] || select_files=$runs/check-
    if [[ $action == dry-run ]]; then
        run_dry_run
        return
    fi
    if [[ $action == check ]]; then
        run_checks || true
        if ((live && check_harness)); then
            run_check_line live FAIL "skipped: the writer cannot start" "fix the checks above"
        elif ((live)); then
            run_check_live || true
        fi
        if ((check_failed)); then
            run_final check "$check_failed failed: $check_reason" "$check_next"
            return
        fi
        run_final done "all checks passed; $run_background" \
            "tools/decomp campaigns run --count 3 --harness $harness"
        return
    fi
    # A run: refuse to take over the state of a run that is still going, then
    # own state.json and check the setup before the first campaign.
    IFS=$'\t' read -r other other_next < <(python tools/decomp_attempts.py run-status --busy \
        --self "$$" 2> /dev/null) || true
    if [[ -n $other ]]; then
        run_final check "$other" "$other_next"
        return
    fi
    run_owns_state=1 run_phase_name=check
    trap 'run_on_exit $?' EXIT
    run_trap_signals
    python tools/decomp_attempts.py event state --state --reset --set "pid=$$" \
        --set "started=$(date -u +%FT%TZ)" --set "harness=$harness" --set "phase=check" \
        --set "campaign=0" --set "count=$count" --set "writer=$writer" || true
    check_quiet=1
    run_checks || true
    if ((check_harness)); then
        run_final writer "harness failure: $check_reason" "$check_next"
        return
    elif ((check_failed)); then
        run_final check "$check_failed failed: $check_reason" "$check_next"
        return
    fi
    run_head=$(git rev-parse HEAD 2> /dev/null || true)
    run_emit harness "harness: $harness ($harness_reason)" --field "harness=$harness" \
        --field "format=$writer_format" --field "writer=$writer"
    # bc reads the budget from here, in the driver and inside the writer alike.
    export DECOMP_BUDGET=$budget
    run_usage_file
    for ((index = 1; index <= count; index++)); do
        run_result=""
        # A campaign left active on an error stays for review; no later stop aborts it.
        run_campaign "$index" || { status=$?; run_active=""; break; }
        # continue-decomp stop rule: three consecutive no-source results across
        # two families mean the queue needs a person, not more writer runs.
        if [[ $run_result == no-source ]]; then families+=("$run_family"); else families=(); fi
        if ((${#families[@]} >= 3)) &&
            (($(printf '%s\n' "${families[@]}" | sort -u | wc -l) >= 2)); then
            run_reason="stop rule: ${#families[@]} consecutive no-source results in"
            run_reason+=" $(printf '%s\n' "${families[@]}" | sort -u | wc -l) families; ask the user"
            run_next="tools/decomp campaigns summary" status=1
            break
        fi
    done
    trap - INT TERM HUP QUIT
    run_emit summary "$(printf 'run: %s campaigns, %s with a gain, %s B, %s attempts, %s min, %s' \
        "$done_count" "$committed" "$total_bytes" "$total_attempts" \
        "$(run_math 'printf "%.1f", a / 60' "$((SECONDS - run_started))")" \
        "$(run_spend "$total_cost" "$total_tokens")")" --field "campaigns=$done_count" \
        --field "gains=$committed" --field "bytes=$total_bytes" --field "attempts=$total_attempts"
    case $status in
        0)
            kind=done run_reason="done: $done_count campaigns, $committed with a gain"
            run_next="tools/decomp campaigns run --count $count --harness $harness"
            if ((committed > 0 && !push)); then
                run_next="git push origin $(git branch --show-current)"
            fi
            ;;
        4) kind=done ;;
        3) kind=writer ;;
        *) kind=review ;;
    esac
    run_final "$kind" "$run_reason" "$run_next"
}

experiment() {
    local action="${1:-}"
    local address="${2:-}"
    if [[ -z "$action" || -z "$address" ]]; then
        echo "Usage: tools/decomp experiment start|try|report <address> [label]" >&2
        return 2
    fi
    local directory="build/decomp-experiments/${address}"
    case "$action" in
        start)
            mkdir -p "$directory"
            build
            write_comparison_report "decomp-experiments/${address}/baseline-report.json"
            write_data_report "decomp-experiments/${address}/baseline-data-report.json"
            refresh_function_sizes
            python tools/decomp_verify.py metadata "$directory/compiler-context.json" \
                --report "$directory/baseline-report.json" \
                --data-report "$directory/baseline-data-report.json"
            git diff --binary > "$directory/baseline.patch"
            echo "Started experiment $address in $directory."
            ;;
        try)
            local label="${3:-}"
            if [[ ! "$label" =~ ^[A-Za-z0-9._-]+$ ]]; then
                echo "error: give the trial a label with letters, numbers, dot, dash, or underscore" >&2
                return 2
            fi
            mkdir -p "$directory"
            build_game
            write_comparison_report "decomp-experiment-${address}-${label}.json"
            git diff --binary > "$directory/${label}.patch"
            (cd build && reccmp-reccmp --target TOY2 --no-color --verbose "$address") \
                > "$directory/${label}.diff.txt"
            cp "build/decomp-experiment-${address}-${label}.json" "$directory/${label}.report.json"
            cp "$directory/compiler-context.json" "$directory/${label}.compiler-context.json"
            python tools/decomp_verify.py experiment \
                "$directory/${label}.report.json" "$address" "$directory/${label}.normalized.json"
            python tools/decomp_verify.py classify "$directory/${label}.report.json" "$address" \
                | tee "$directory/${label}.summary.txt"
            python tools/decomp_campaigns.py first-score --address "$address" --quiet
            ;;
        report)
            find "$directory" -maxdepth 1 -name '*.summary.txt' -print -exec sed -n '1,4p' {} \;
            ;;
        *)
            echo "error: experiment action must be start, try, or report" >&2
            return 2
            ;;
    esac
}

report() {
    local output="${1:-build/decomp-report.html}"
    local report_json="build/decomp-report-data.json"
    local report_summary="build/decomp-report-summary.txt"
    local function_sizes="build/decomp-function-sizes.json"
    local data_report="build/decomp-data-report.json"

    if [[ $# -gt 1 ]]; then
        echo "Usage: tools/decomp report [output.html]" >&2
        return 2
    fi
    ensure_build

    (
        cd build
        reccmp-reccmp \
            --target TOY2 \
            --silent \
            --no-color \
            --json "$(basename "$report_json")"
    ) > "$report_summary"
    cat "$report_summary"

    refresh_function_sizes
    python tools/decomp_verify.py scoreboard "$report_json" \
        tools/Resources/scoreboard.tsv --generated-by report

    python tools/generate-decomp-data-report.py \
        --original original/toy2.exe \
        --recompiled build/toy2.exe \
        --pdb build/toy2.pdb \
        --source-root src \
        --output "$data_report"

    python tools/generate-decomp-report.py \
        --input "$report_json" \
        --summary "$report_summary" \
        --source-root src \
        --functions-map tools/Resources/functions_map.txt \
        --function-sizes "$function_sizes" \
        --retail-exe original/toy2.exe \
        --recompiled-exe build/toy2.exe \
        --data-report "$data_report" \
        --template tools/decomp-report-template.html \
        --output "$output"
}

usage() {
    cat <<'EOF'
Usage: tools/decomp <command> [arguments]

Commands:
  configure         Configure the VC6 SP3 build through Wine
  build             Build toy2.exe/patcher.dll and register the output
  compare [args]    Run reccmp against the reference and recompiled EXEs
  score <addr>...   Print only the similarity verdict for one or more addresses
  bc <addr>         Build toy2.exe, then compare one address verbosely
  notes <query>     Search bounded codegen, source-model, debt, and name notes
  candidates [ns]   Rank reconstruction candidates (no Ghidra, no reccmp run)
  campaigns [...]   Measure campaign time, report deltas, and retained throughput
  discover [args]   Find credible Ghidra starts absent from the function map
  defer <addr> ...  Record a committed blocker or prerequisite
  undefer <addr>    Clear all committed blockers for one target
  blockers [addr]   Show committed blockers
  evidence <addr>   Collect bounded evidence for one target in a single call
  handoff <addr>    Save stdin as a target's writer handoff (bc --pack prints it)
  baseline          Save a fresh parent-state comparison before source edits
  validate [args]   Enforce coverage, refinement, data, or resource success
  experiment [...] Record labeled source-form comparison trials
  lint [files]      Check reconstructed source for decompiler residue
  names             Re-extract .notes/original-names.md from the retail binary
  data [addr]       Show type-aware initialized-global differences
  report [file]     Generate the self-contained HTML decompilation dashboard
  session-summary   Summarize selected targets against the saved baseline
  progress [--json] [scope]  Show annotation progress
  throughput [args] Git-derived throughput meter (--experiments, --cap-check, --runs)
  check             Verify functions_map.txt is sorted, deduplicated, named, in-range
  run [args]        Run the recompiled toy2.exe through Wine
  shell             Start a shell with the decompilation environment active
  sync [args]       Import matched functions/types/globals into Ghidra via reccmp

The loop (see AGENTS.md): candidates -> campaigns start -> evidence -> edit ->
bc (repeat) -> campaigns finish (validate --staged, record, commit) -> push.
  tools/decomp candidates --refine --yield --why      # or --coverage --why
  tools/decomp candidates --for 0x00401230 --why      # explain one target
  tools/decomp campaigns start --mode refinement --address 0x00403640 \
    --subsystem Animation
  tools/decomp evidence 0x00403640 [--disasm | --unmapped | --full]
  tools/decomp bc 0x00403640          # logs the attempt, saves the best patch
  tools/decomp validate --mode refinement --target 0x00403640 --staged
  tools/decomp campaigns finish --mode refinement --target 0x00403640 \
    --note "result note" --message commit-message.txt   # or record by hand:
  tools/decomp campaigns record --result source
  tools/decomp campaigns record --result no-source --model "rejected model"
  tools/decomp campaigns evidence --address 0x00403640 --kind analogue \
    --note "new evidence that clears a zero-yield penalty"
  tools/decomp campaigns status | summary | abort --reason TEXT | add-target
  tools/decomp campaigns run --count 3 [--mode auto] [--push]  # no model needed
  tools/decomp campaigns run --check --live | --dry-run | --status  # --help: exit codes

Output is bounded: `candidates` and `discover` show 10 rows (`--limit 0` or
`--all` for all), `evidence` 12 rows per category (`--full` for all), `bc`
three mismatch windows (`bc --full` for the whole diff). `lint` measures source
plausibility (`--staged`, `--explain RULE`, `--format json`); new errors fail
validate. `throughput` reads git and tools/Resources/scoreboard.tsv.
TOY2_BUILD_JOBS sets build parallelism (TOY2_LOCAL_BUILD_JOBS in .decomp-local).
EOF
}

command="${1:-}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command" in
    help|-h|--help|"")
        usage
        exit 0
        ;;
esac

source tools/linux-decomp-env.sh

case "$command" in
    discover)
        exec python tools/decomp_discover.py "$@"
        ;;
    candidates)
        exec python tools/decomp_candidates.py "$@"
        ;;
    campaigns)
        for campaign_argument in "$@"; do
            if [[ $campaign_argument == -h || $campaign_argument == --help ]]; then
                case " $* " in
                    *" finish "*) finish_usage; exit 0 ;;
                    *" run "*) run_usage; exit 0 ;;
                esac
                exec python tools/decomp_campaigns.py "$@"
            fi
        done
        campaign_action=""
        campaign_state_file="build/decomp-campaign-state.json"
        campaign_global_arguments=()
        campaign_arguments=("$@")
        campaign_index=0
        while [[ $campaign_index -lt ${#campaign_arguments[@]} ]]; do
            campaign_argument="${campaign_arguments[$campaign_index]}"
            case "$campaign_argument" in
                --state-file)
                    if [[ $((campaign_index + 1)) -ge ${#campaign_arguments[@]} ]]; then
                        exec python tools/decomp_campaigns.py "$@"
                    fi
                    campaign_state_file="${campaign_arguments[$((campaign_index + 1))]}"
                    campaign_global_arguments+=(
                        "$campaign_argument"
                        "${campaign_arguments[$((campaign_index + 1))]}"
                    )
                    campaign_index=$((campaign_index + 2))
                    ;;
                --state-file=*)
                    campaign_state_file="${campaign_argument#*=}"
                    campaign_global_arguments+=("$campaign_argument")
                    campaign_index=$((campaign_index + 1))
                    ;;
                --file|--source-models|--functions-map|--function-sizes|--worktree-root|--source-root)
                    if [[ $((campaign_index + 1)) -ge ${#campaign_arguments[@]} ]]; then
                        exec python tools/decomp_campaigns.py "$@"
                    fi
                    campaign_global_arguments+=(
                        "$campaign_argument"
                        "${campaign_arguments[$((campaign_index + 1))]}"
                    )
                    campaign_index=$((campaign_index + 2))
                    ;;
                --file=*|--source-models=*|--functions-map=*|--function-sizes=*|--worktree-root=*|--source-root=*)
                    campaign_global_arguments+=("$campaign_argument")
                    campaign_index=$((campaign_index + 1))
                    ;;
                *)
                    campaign_action="$campaign_argument"
                    break
                    ;;
            esac
        done
        case "$campaign_action" in
            start)
                python tools/decomp_campaigns.py "$@"
                if ! baseline; then
                    python tools/decomp_campaigns.py "${campaign_global_arguments[@]}" abort \
                        --reason "The campaign baseline command failed."
                    exit 1
                fi
                if ! python tools/decomp_campaigns.py \
                    "${campaign_global_arguments[@]}" set-baseline --quiet; then
                    python tools/decomp_campaigns.py "${campaign_global_arguments[@]}" abort \
                        --reason "The campaign baseline attachment failed."
                    exit 1
                fi
                ;;
            record)
                if campaign_state_is_finalizing "$campaign_state_file"; then
                    exec python tools/decomp_campaigns.py "$@"
                fi
                build
                write_comparison_report decomp-current-report.json
                write_data_report decomp-current-data-report.json
                exec python tools/decomp_campaigns.py "$@"
                ;;
            finish)
                campaign_finish "${campaign_arguments[@]:$((campaign_index + 1))}"
                ;;
            run)
                campaign_run "${campaign_arguments[@]:$((campaign_index + 1))}"
                ;;
            *)
                exec python tools/decomp_campaigns.py "$@"
                ;;
        esac
        ;;
    defer)
        if [[ $# -lt 3 ]]; then
            echo "Usage: tools/decomp defer <address> [--blocked-by <address> ...] --reason <text>" >&2
            exit 2
        fi
        address="$1"
        shift
        exec python tools/decomp_candidates.py --record-deferral "$address" "$@"
        ;;
    undefer)
        if [[ $# -ne 1 ]]; then
            echo "Usage: tools/decomp undefer <address>" >&2
            exit 2
        fi
        exec python tools/decomp_candidates.py --clear-deferral "$1"
        ;;
    blockers)
        address=""
        if [[ $# -gt 0 && $1 != --* ]]; then address="$1"; shift; fi
        exec python tools/decomp_candidates.py --list-blockers "$address" "$@"
        ;;
    evidence)
        exec python tools/decomp_evidence.py "$@"
        ;;
    notes)
        exec python tools/decomp_notes.py "$@"
        ;;
    handoff)
        handoff "$@"
        ;;
    lint)
        exec python tools/decomp_lint.py "$@"
        ;;
    names)
        exec python tools/decomp_original_names.py "$@"
        ;;
    configure)
        configure "$@"
        ;;
    build)
        build "$@"
        ;;
    compare)
        ensure_build
        (cd build && reccmp-reccmp --target TOY2 "$@")
        ;;
    score)
        score "$@"
        ;;
    bc)
        # bc ADDRESS            build, compare, log the attempt, print the region index
        # bc ADDRESS --hunk N   print one mismatch region (or N,N,... several) from the saved diff (no build)
        # bc ADDRESS --hunks    print the region index from the saved diff (no build)
        # bc ADDRESS --compact  print the compact diff (changed lines only, no build)
        # bc ADDRESS --pack     print the orientation pack for a fresh batch (no build)
        # bc ADDRESS --full     build, compare, then print the raw diff
        full=0
        view=()
        bc_args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --full) full=1 ;;
                --hunks|--compact|--pack) view=("$1") ;;
                --hunk) view=(--hunk "$2"); shift ;;
                *) bc_args+=("$1") ;;
            esac
            shift
        done
        set -- "${bc_args[@]}"
        if [[ $# -ne 1 ]]; then
            echo "Usage: tools/decomp bc [--full | --hunks | --hunk N[,N...] | --compact | --pack] <address>" >&2
            exit 2
        fi
        if [[ ! $1 =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
            echo "error: bc needs an address such as 0x00401230" >&2
            exit 2
        fi
        mkdir -p build/decomp-diffs
        diff_path="build/decomp-diffs/${1}.txt"
        compact_path="build/decomp-diffs/${1}.compact.txt"
        if [[ ${#view[@]} -gt 0 ]]; then
            if [[ ! -f $diff_path ]]; then
                echo "error: no saved diff for $1; run tools/decomp bc $1 first" >&2
                exit 2
            fi
            if [[ ${view[0]} == --pack ]]; then
                bc_pack "$1" "$diff_path"
                exit
            fi
            saved_diff_line "$1"
            # --hunk 3,7,9 prints several regions in one call; writers otherwise loop in
            # the shell, which the harness permission check denies.
            if [[ ${view[0]} == --hunk && ${view[1]} == *,* ]]; then
                IFS=, read -ra hunk_numbers <<< "${view[1]}"
                for hunk_number in "${hunk_numbers[@]}"; do
                    python tools/decomp_diff.py "$diff_path" --hunk "$hunk_number" || exit $?
                done
                exit 0
            fi
            exec python tools/decomp_diff.py "$diff_path" "${view[@]}"
        fi
        if ! build_game; then
            echo "bc: no attempt logged; fix the error above and run bc again" >&2
            exit 2
        fi
        # Keep the last diff, so the attempt view can say what this attempt changed.
        prev_path="build/decomp-diffs/${1}.prev.txt"
        if [[ -f $diff_path ]]; then
            cp "$diff_path" "$prev_path"
        else
            rm -f "$prev_path"
        fi
        (cd build && reccmp-reccmp --target TOY2 --no-color --verbose "$1") \
            > "$diff_path" 2> "$diff_path.stderr" || true
        grep -v '^\[INFO\]' "$diff_path.stderr" >&2 || true
        rm -f "$diff_path.stderr"
        if git diff --name-only HEAD -- src | grep -q '\.h$'; then
            header_side_effects "$1"
        fi
        python tools/decomp_attempts.py attempt --address "$1" --diff "$diff_path" || true
        # validate --staged rejects new lint errors and warnings; show them now,
        # while the writer still holds the context to fix them. The readability
        # rules print as advice: validate does not reject them.
        mapfile -t changed_sources < <(git diff --name-only HEAD -- 'src/*.cpp' 'src/*.h')
        if [[ ${#changed_sources[@]} -gt 0 ]]; then
            python tools/decomp_lint.py --warnings-as-errors "${changed_sources[@]}" \
                | grep -E ': (error|warning): ' \
                | sed -E '/\[(unnamed-constant|repeated-macro-body)\]/{s/^/advice: /;b};s/^/lint: /' || true
        fi
        diff_args=(
            "$diff_path"
            --address "$1"
            --functions-map tools/Resources/functions_map.txt
            --function-sizes build/decomp-function-sizes.json
            --source-root src
            --write-compact "$compact_path"
        )
        if [[ $full -eq 1 ]]; then
            python tools/decomp_diff.py "${diff_args[@]}" --full
        else
            python tools/decomp_diff.py "${diff_args[@]}"
            # The regions this attempt changed, with their source lines, so the
            # writer rarely needs a --hunk or sed call before the next edit.
            python tools/decomp_diff.py "$diff_path" --attempt-view --previous "$prev_path" \
                --address "$1" --source-root src || true
        fi
        python tools/decomp_campaigns.py first-score --address "$1" --quiet
        ;;
    baseline)
        baseline "$@"
        ;;
    validate)
        validate "$@"
        ;;
    experiment)
        experiment "$@"
        ;;
    report)
        report "$@"
        ;;
    data)
        for argument in "$@"; do
            if [[ $argument == -h || $argument == --help ]]; then
                exec python tools/decomp_data.py --help
            fi
        done
        ensure_build
        write_data_report decomp-data-report.json
        python tools/decomp_data.py "$@"
        for argument in "$@"; do
            if [[ $argument =~ ^0x[0-9A-Fa-f]{1,8}$ ]]; then
                python tools/decomp_campaigns.py first-score --address "$argument" --quiet
            fi
        done
        ;;
    session-summary)
        if [[ $# -eq 0 ]]; then
            echo "Usage: tools/decomp session-summary <address> [address...]" >&2
            exit 2
        fi
        exec python tools/decomp_verify.py session-summary \
            build/decomp-baseline-report.json build/decomp-report-data.json "$@"
        ;;
    throughput)
        exec python tools/decomp_throughput.py "$@"
        ;;
    progress)
        if [[ ${1:-} == "--json" ]]; then
            shift
            if [[ $# -gt 1 ]]; then echo "Usage: tools/decomp progress [--json] [namespace]" >&2; exit 2; fi
            if [[ $# -eq 1 ]]; then
                python decomp_utils.py --progress "$1" --json
            else
                python decomp_utils.py --progress --json
            fi
        elif [[ $# -gt 1 ]]; then
            echo "Usage: tools/decomp progress [--json] [namespace]" >&2
            exit 2
        elif [[ $# -eq 1 ]]; then
            python decomp_utils.py --progress "$1"
        else
            python decomp_utils.py --progress
        fi
        ;;
    check)
        python tools/ghidra_sync.py check "$@"
        ;;
    run)
        ensure_build
        exec wine build/toy2.exe "$@"
        ;;
    shell)
        exec "${SHELL:-/bin/bash}" -i
        ;;
    sync)
        python tools/ghidra_sync.py sync "$@"
        ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
