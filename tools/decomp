#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ -f .decomp-local ]]; then
    source .decomp-local
fi

build_jobs="${TOY2_BUILD_JOBS:-${TOY2_LOCAL_BUILD_JOBS:-4}}"

configure() {
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_SYSTEM_NAME=Windows \
        -DCMAKE_C_COMPILER=cl \
        -DCMAKE_CXX_COMPILER=cl \
        -DCMAKE_RC_COMPILER=rc \
        -DCMAKE_C_DEPFILE_FORMAT=msvc \
        -DCMAKE_DEPFILE_FLAGS_C=/showIncludes \
        -DCMAKE_CXX_DEPFILE_FORMAT=msvc \
        -DCMAKE_DEPFILE_FLAGS_CXX=/showIncludes
}

build() {
    if [[ ! -f build/build.ninja ]]; then
        configure
    fi
    cmake --build build -- "-j${build_jobs}"
    (
        cd build
        reccmp-project detect --what recompiled
    )
}

build_game() {
    if [[ ! -f build/build.ninja ]]; then
        configure
    fi
    cmake --build build --target toy2decomp -- "-j${build_jobs}"
    (
        cd build
        reccmp-project detect --what recompiled
    )
}

# Print only the per-function similarity verdict for each given address. One
# PDB parse serves every address, and no assembly diff reaches the caller.
score() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: tools/decomp score <address> [address...]" >&2
        return 2
    fi
    ensure_build
    write_comparison_report decomp-score-report.json
    python tools/decomp_verify.py score build/decomp-score-report.json "$@"
}

ensure_build() {
    if [[ ! -f build/reccmp-build.yml || ! -f build/toy2.exe || ! -f build/toy2.pdb ]]; then
        build
    fi
}

write_comparison_report() {
    local output_name="$1"
    (
        cd build
        reccmp-reccmp --target TOY2 --silent --no-color --json "$output_name"
    ) >/dev/null
}

baseline() {
    build
    write_comparison_report decomp-baseline-report.json
    python tools/decomp_verify.py metadata build/decomp-baseline-meta.json \
        --report build/decomp-baseline-report.json
    echo "Wrote build/decomp-baseline-report.json for $(git rev-parse --short HEAD)."
}

validate() {
    local allow_target_regression=0
    local staged=0
    local targets=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ $# -ge 2 ]] || { echo "error: --target needs an address" >&2; return 2; }
                targets+=("$2")
                shift 2
                ;;
            --allow-target-regression)
                allow_target_regression=1
                shift
                ;;
            --staged)
                staged=1
                shift
                ;;
            *)
                echo "error: unknown validate argument: $1" >&2
                return 2
                ;;
        esac
    done
    if [[ ${#targets[@]} -eq 0 ]]; then
        echo "error: validate needs at least one --target address" >&2
        return 2
    fi
    if [[ ! -f build/decomp-baseline-report.json ]]; then
        echo "error: run tools/decomp baseline before you edit source" >&2
        return 2
    fi

    build
    write_comparison_report decomp-current-report.json
    local verify_args=(
        validate
        build/decomp-baseline-report.json
        build/decomp-current-report.json
        "${targets[@]}"
        --metadata build/decomp-baseline-meta.json
    )
    if [[ $allow_target_regression -eq 1 ]]; then
        verify_args+=(--allow-target-regression)
    fi
    python tools/decomp_verify.py "${verify_args[@]}"
    if [[ $staged -eq 1 ]]; then
        python tools/decomp_lint.py --staged --warnings-as-errors
    fi
    python tools/ghidra_sync.py check
    git diff --check
}

experiment() {
    local action="${1:-}"
    local address="${2:-}"
    if [[ -z "$action" || -z "$address" ]]; then
        echo "Usage: tools/decomp experiment start|try|report <address> [label]" >&2
        return 2
    fi
    local directory="build/decomp-experiments/${address}"
    case "$action" in
        start)
            mkdir -p "$directory"
            baseline
            git diff --binary > "$directory/baseline.patch"
            cp build/decomp-baseline-meta.json "$directory/compiler-context.json"
            echo "Started experiment $address in $directory."
            ;;
        try)
            local label="${3:-}"
            if [[ ! "$label" =~ ^[A-Za-z0-9._-]+$ ]]; then
                echo "error: give the trial a label with letters, numbers, dot, dash, or underscore" >&2
                return 2
            fi
            mkdir -p "$directory"
            build_game
            write_comparison_report "decomp-experiment-${address}-${label}.json"
            git diff --binary > "$directory/${label}.patch"
            (cd build && reccmp-reccmp --target TOY2 --no-color --verbose "$address") \
                > "$directory/${label}.diff.txt"
            cp "build/decomp-experiment-${address}-${label}.json" "$directory/${label}.report.json"
            cp build/decomp-baseline-meta.json "$directory/${label}.compiler-context.json"
            python tools/decomp_verify.py experiment \
                "$directory/${label}.report.json" "$address" "$directory/${label}.normalized.json"
            python tools/decomp_verify.py classify "$directory/${label}.report.json" "$address" \
                | tee "$directory/${label}.summary.txt"
            ;;
        report)
            find "$directory" -maxdepth 1 -name '*.summary.txt' -print -exec sed -n '1,4p' {} \;
            ;;
        *)
            echo "error: experiment action must be start, try, or report" >&2
            return 2
            ;;
    esac
}

report() {
    local output="${1:-build/decomp-report.html}"
    local report_json="build/decomp-report-data.json"
    local report_summary="build/decomp-report-summary.txt"
    local function_sizes="build/decomp-function-sizes.json"

    if [[ $# -gt 1 ]]; then
        echo "Usage: tools/decomp report [output.html]" >&2
        return 2
    fi
    ensure_build

    (
        cd build
        reccmp-reccmp \
            --target TOY2 \
            --silent \
            --no-color \
            --json "$(basename "$report_json")"
    ) > "$report_summary"
    cat "$report_summary"

    if command -v ghidra >/dev/null 2>&1; then
        ghidra function list --json --limit 0 --fields address,size > "$function_sizes" || rm -f "$function_sizes"
    fi

    python tools/generate-decomp-report.py \
        --input "$report_json" \
        --summary "$report_summary" \
        --source-root src \
        --functions-map tools/Resources/functions_map.txt \
        --function-sizes "$function_sizes" \
        --template tools/decomp-report-template.html \
        --output "$output"
}

usage() {
    cat <<'EOF'
Usage: tools/decomp <command> [arguments]

Commands:
  configure         Configure the VC6 SP3 build through Wine
  build             Build toy2.exe/patcher.dll and register the output
  compare [args]    Run reccmp against the reference and recompiled EXEs
  score <addr>...   Print only the similarity verdict for one or more addresses
  bc <addr>         Build toy2.exe, then compare one address verbosely
  candidates [ns]   Rank reconstruction candidates (no Ghidra, no reccmp run)
  evidence <addr>   Collect bounded evidence for one target in a single call
  audit [args]      Rank provisional functions for source and binary audit
  baseline          Save a fresh parent-state comparison before source edits
  validate [args]   Build and reject verification or score regressions
  experiment [...] Record labeled source-form comparison trials
  lint [files]      Check reconstructed source for decompiler residue
  names             Re-extract .notes/original-names.md from the retail binary
  report [file]     Generate the self-contained HTML decompilation dashboard
  progress [scope]  Show annotation progress, optionally for a namespace
  check             Verify functions_map.txt is sorted, deduplicated, named, in-range
  run [args]        Run the recompiled toy2.exe through Wine
  shell             Start a shell with the decompilation environment active
  sync [args]       Import matched functions/types/globals into Ghidra via reccmp

`candidates` and `evidence` read only committed files plus the build report, so
they are fast and safe to run first:
  tools/decomp candidates --debt --why        # matched but still states offsets
  tools/decomp candidates --stubs --limit 10
  tools/decomp candidates Nu3D --leaves --why
  tools/decomp evidence 0x00403640
  tools/decomp evidence 0x00403640 --disasm
  tools/decomp audit --legacy-caps --limit 20

`score` avoids the assembly diff when you only need the percentage:
  tools/decomp score 0x00403640 0x004B99F0

`lint` measures source plausibility, which the comparison cannot see. An exact
match that still states byte offsets is a transliteration, not a
reconstruction:
  tools/decomp lint                 # all of src/
  tools/decomp lint --staged        # only what you are about to commit
  tools/decomp lint --show new      # only findings that are not in the baseline
  tools/decomp lint --explain RULE  # rationale and required source form
  tools/decomp lint --format json   # structured findings for other tools

Reviewed old findings are in .notes/lint-baseline.tsv. They remain visible but
do not stop unrelated work. New errors and stale baseline rows fail the gate.
See .notes/lint-rules.md for the rule and suppression policy.

`names` regenerates .notes/original-names.md, the developers' own structure and
field names recovered from the retail assert strings. Those names outrank any
name you would invent.

`sync` runs reccmp's headless Ghidra importer (`reccmp-ghidra-import`) against
the local Ghidra project. Extra arguments are forwarded to the importer, e.g.
  tools/decomp sync --debug
The Ghidra project location is read from the `ghidra` CLI configuration.

TOY2_BUILD_JOBS sets the build parallelism for one command. The default is 4.
Set TOY2_LOCAL_BUILD_JOBS in .decomp-local for this checkout. See
docs/linux-decomp.md.
EOF
}

command="${1:-}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command" in
    help|-h|--help|"")
        usage
        exit 0
        ;;
esac

source tools/linux-decomp-env.sh

case "$command" in
    candidates)
        exec python tools/decomp_candidates.py "$@"
        ;;
    audit)
        exec python tools/decomp_candidates.py --audit "$@"
        ;;
    evidence)
        exec python tools/decomp_evidence.py "$@"
        ;;
    lint)
        exec python tools/decomp_lint.py "$@"
        ;;
    names)
        exec python tools/decomp_original_names.py "$@"
        ;;
    configure)
        configure "$@"
        ;;
    build)
        build "$@"
        ;;
    compare)
        ensure_build
        (cd build && reccmp-reccmp --target TOY2 "$@")
        ;;
    score)
        score "$@"
        ;;
    bc)
        if [[ $# -ne 1 ]]; then
            echo "Usage: tools/decomp bc <address>" >&2
            exit 2
        fi
        build_game
        (cd build && reccmp-reccmp --target TOY2 --verbose "$1")
        ;;
    baseline)
        baseline "$@"
        ;;
    validate)
        validate "$@"
        ;;
    experiment)
        experiment "$@"
        ;;
    report)
        report "$@"
        ;;
    progress)
        if [[ $# -gt 1 ]]; then
            echo "Usage: tools/decomp progress [namespace]" >&2
            exit 2
        elif [[ $# -eq 1 ]]; then
            python decomp_utils.py --progress "$1"
        else
            python decomp_utils.py --progress
        fi
        ;;
    check)
        python tools/ghidra_sync.py check "$@"
        ;;
    run)
        ensure_build
        exec wine build/toy2.exe "$@"
        ;;
    shell)
        exec "${SHELL:-/bin/bash}" -i
        ;;
    sync)
        python tools/ghidra_sync.py sync "$@"
        ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
